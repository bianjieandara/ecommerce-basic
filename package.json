{
  "name": "ecommerce-basic",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check": "astro check && eslint . && prettier --check .",
    "format": "prettier --write .",
    "lint": "eslint .",
    "cf-typegen": "wrangler types",
    "predev": "node scripts/use-client.mjs",
    "prebuild": "node scripts/use-client.mjs",
    "precf-typegen": "node scripts/use-client.mjs",
    "client:new": "node scripts/new-client.mjs",
    "client:secrets": "node scripts/client-secrets.mjs",
    "deploy:client": "node scripts/deploy-client.mjs",
    "deploy:all": "node scripts/deploy-all.mjs",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "docs:store": "node scripts/docs/store.mjs",
    "test:smoke": "node scripts/test/smoke.mjs",
    "test:webhooks": "node scripts/test/webhooks.mjs",
    "docs:data": "node scripts/docs/demo-data.mjs",
    "docs:screens": "node scripts/docs/screenshots.mjs",
    "docs:dev": "npm --prefix docs-site run dev",
    "docs:build": "npm --prefix docs-site run build",
    "db:seed:local": "wrangler d1 execute DB --local --file=db/seed/dev.sql"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.2",
    "@astrojs/preact": "^6.1.1",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/manrope": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@fontsource-variable/sora": "^5.3.0",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/preact": "^1.1.1",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.2",
    "micromark": "^4.0.3",
    "nanostores": "^1.5.5",
    "preact": "^11.0.1",
    "tailwindcss": "^4.3.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/node": "^26.6.5",
    "eslint": "^10.13.0",
    "eslint-plugin-astro": "^1.7.0",
    "globals": "^17.13.0",
    "jsonc-parser": "^3.3.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "wrangler": "^4.151.3"
  }
}
