{
  "slug": "demo",
  "workerName": "demo-store",
  "accountId": null,
  "d1": {
    "name": "demo-db",
    "id": "22f27fe6-c0c8-4f25-9274-91b2094ae7e8",
  },
  "r2": {
    "bucket": "demo-media",
  },
  "kv": {
    "id": "caee3d49db1140ca82d31e7f77115444",
  },
  "queue": {
    "name": "demo-jobs",
    "dlq": "demo-jobs-dlq",
  },
  "analyticsDataset": "demo_events",
  "rateLimitNamespaceBase": 1000,
  "cron": "*/15 * * * *",
  "customDomains": ["ecommerce.relion-app.com"],
  // The public demo uses Cloudflare's test Turnstile key on purpose (see docs/DECISIONS.md). Real stores must not set this.
  "allowTestTurnstile": true,
  // Demo mode: a shared login, the nightly reset from demo/snapshot.json, and e-mails kept in the outbox instead of sent.
  // DEMO_LOGIN_EMAIL and DEMO_LOGIN_PASSWORD are public by design (the login page shows them): choose them before publishing.
  "vars": {
    "DEMO_MODE": "on",
    "DEMO_LOGIN_EMAIL": "demo@ecommerce.relion-app.com",
    "DEMO_LOGIN_PASSWORD": "demo-tienda-2026",
    "DEMO_GUIDE_URL": "https://docs.relion-app.com/clients/try-the-demo/",
    "DEMO_PAYPAL_BUYER_EMAIL": "",
    "DEMO_PAYPAL_BUYER_PASSWORD": "",
    "EMAIL_TRANSPORT": "outbox",
    "PUBLIC_SITE_URL": "https://ecommerce.relion-app.com",
    "EMAIL_FROM": "Store <orders@ecommerce.relion-app.com>",
    "PAYPAL_ENV": "sandbox",
    "DLOCALGO_ENV": "sandbox",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "PUBLIC_MEDIA_BASE_URL": "",
    "WHATSAPP_PHONE_NUMBER_ID": "",
    "WHATSAPP_WABA_ID": "",
    "META_GRAPH_VERSION": "",
  },
}
