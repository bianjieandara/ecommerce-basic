---
// Admin shell: the header (search, menu, sign out), a small breadcrumb with the section and page, and the page content. Every
// admin page uses it; the pages check the session themselves.
import BaseLayout from './BaseLayout.astro';
import AdminTopBar from '@/ui/admin/AdminTopBar.astro';
import { findAdminNav } from '@/ui/admin/lib/nav';
import type { Locale } from '@/domain/shared/locale';
import { t } from '@/ui/i18n';
import '@/ui/styles/admin-table.css';

interface Props {
  title: string;
  locale: Locale;
  storeName: string;
}

const { title, locale, storeName } = Astro.props;
const place = findAdminNav(Astro.url.pathname);
// The dashboard is outside the menu: its crumb is the page itself.
const crumb = place ? `${t(locale, place.group.label)} / ${t(locale, place.item.label)}` : title;
---

<BaseLayout title={`${title} · ${storeName}`} locale={locale} noindex>
  <AdminTopBar locale={locale} storeName={storeName} />
  <main
    id="main"
    tabindex="-1"
    class="admin mx-auto flex w-full max-w-7xl flex-col gap-6 px-4 py-6 focus:outline-none md:px-8 md:py-8"
  >
    <p class="text-xs tracking-wide text-text/60">{crumb}</p>
    <slot />
  </main>
</BaseLayout>
