---
// Single-column layout for the sign-in and password pages. No store navigation, and never indexed.
import BaseLayout from './BaseLayout.astro';
import type { Locale } from '@/domain/shared/locale';

interface Props {
  title: string;
  locale: Locale;
  storeName: string;
}

const { title, locale, storeName } = Astro.props;
---

<BaseLayout title={`${title} · ${storeName}`} locale={locale} noindex>
  <main class="mx-auto flex min-h-dvh w-full max-w-sm flex-col justify-center gap-6 p-4">
    <p class="text-text/60 text-sm">{storeName}</p>
    <h1 class="text-2xl font-semibold">{title}</h1>
    <slot />
  </main>
</BaseLayout>
