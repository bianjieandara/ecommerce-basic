---
// Base HTML document: language, metadata, theme variables, global CSS and the shared interaction scripts.
// Every page uses this (directly, or through StoreLayout). Theme CSS comes from settings via themeToCss.
import '@/ui/styles/global.css';
import { DEFAULT_LOCALE, type Locale } from '@/domain/shared/locale';
import type { CurrencyCode } from '@/domain/shared/currency';
import type { JsonLd } from '@/ui/lib/structured-data';
import SeoHead from './SeoHead.astro';
// The Latin subset of each preset, as hashed asset URLs. Preloading the one the store uses stops the text from changing
// width when the web font replaces the fallback (that shift was most of the shop page's layout shift).
import interFont from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import manropeFont from '@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url';
import playfairFont from '@fontsource-variable/playfair-display/files/playfair-display-latin-wght-normal.woff2?url';

const FONT_FILES = { inter: interFont, manrope: manropeFont, playfair: playfairFont } as const;

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  /** Other-language URLs of this page, for hreflang. */
  alternates?: Partial<Record<Locale, string>>;
  canonical?: string;
  noindex?: boolean;
  /** Store default language, used for the hreflang x-default. */
  defaultLocale?: Locale;
  siteName?: string;
  /** Sharing image: a path or an absolute URL. */
  ogImage?: string;
  ogType?: 'website' | 'product';
  /** Structured data nodes for this page. */
  jsonLd?: JsonLd[];
  /** Theme CSS (:root block) built from settings. Empty uses the defaults in global.css. */
  themeCss?: string;
  /** Font preset of the theme; its main font file is preloaded. */
  fontPreset?: keyof typeof FONT_FILES;
  /** Web Analytics token (Cloudflare Web Analytics). Empty means no beacon. */
  webAnalyticsToken?: string;
  /** Meta Pixel id from the marketing settings. Empty means no Pixel; it loads only after marketing consent. */
  metaPixelId?: string;
  /** Store currency, sent to the Pixel with the value of each event. */
  currency?: CurrencyCode;
}

const {
  title,
  description = '',
  locale,
  alternates = {},
  canonical,
  noindex = false,
  defaultLocale = DEFAULT_LOCALE,
  siteName = '',
  ogImage,
  ogType = 'website',
  jsonLd = [],
  themeCss = '',
  fontPreset,
  webAnalyticsToken = '',
  metaPixelId = '',
  currency = 'USD',
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <SeoHead
      title={title}
      description={description}
      locale={locale}
      alternates={alternates}
      canonical={canonical}
      noindex={noindex}
      defaultLocale={defaultLocale}
      siteName={siteName}
      ogImage={ogImage}
      ogType={ogType}
      jsonLd={jsonLd}
    />
    <meta name="theme-color" content="#111111" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {fontPreset && (
      <link rel="preload" as="font" type="font/woff2" href={FONT_FILES[fontPreset]} crossorigin />
    )}
    {themeCss && <style set:html={themeCss} />}
    {webAnalyticsToken && (
      <script
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: webAnalyticsToken })}
      />
    )}
  </head>
  <body class="antialiased" data-meta-pixel-id={metaPixelId} data-currency={currency}>
    <slot />
    <script>
      import { initCarousels } from '@/ui/scripts/carousel';
      import { initDialogs } from '@/ui/scripts/dialog';
      import { initReveal } from '@/ui/scripts/reveal';
      import { initTracking } from '@/ui/lib/track';
      initCarousels();
      initDialogs();
      initReveal();
      initTracking();
    </script>
  </body>
</html>
