---
// Storefront layout: BaseLayout plus header, footer, mobile tab bar, WhatsApp button and the toast region.
import BaseLayout from './BaseLayout.astro';
import Header from '../store/Header.astro';
import Footer from '../store/Footer.astro';
import MobileTabBar from '../store/MobileTabBar.astro';
import WhatsAppFloat from '../store/WhatsAppFloat.astro';
import Toaster from '../components/Toaster';
import type { Locale } from '@/domain/shared/locale';
import type { JsonLd } from '@/ui/lib/structured-data';
import type { CurrencyCode } from '@/domain/shared/currency';
import { t } from '@/ui/i18n';
import { routes } from '@/ui/lib/routes';
import { isMarketingToolEnabled } from '@/domain/consent/consent';
import CartDrawer from '../store/CartDrawer.tsx';
import ConsentBanner from '../store/ConsentBanner.tsx';

interface Props {
  title: string;
  description?: string;
  locale: Locale;
  storeName: string;
  alternates?: Partial<Record<Locale, string>>;
  canonical?: string;
  noindex?: boolean;
  defaultLocale?: Locale;
  ogImage?: string;
  ogType?: 'website' | 'product';
  jsonLd?: JsonLd[];
  themeCss?: string;
  fontPreset?: 'inter' | 'manrope' | 'playfair' | 'editorial';
  webAnalyticsToken?: string;
  currency?: CurrencyCode;
  country?: string;
  contact?: {
    email: string;
    address: string;
    whatsappNumber: string;
    whatsappMessage: string;
    showWhatsappFloat: boolean;
  };
}

const {
  title,
  description,
  locale,
  storeName,
  alternates,
  canonical,
  noindex,
  defaultLocale,
  ogImage,
  ogType,
  jsonLd,
  themeCss,
  fontPreset,
  webAnalyticsToken,
  contact = { email: '', address: '', whatsappNumber: '', whatsappMessage: '', showWhatsappFloat: false },
  currency = 'USD',
  country = 'CO',
} = Astro.props;

// The marketing group is not in the page's store context. The settings table is read once per request, and the pages
// have already read it, so this costs no extra query. Nothing here depends on the visitor's cookies: the page cache keys
// on the path only, so the HTML must be the same for every visitor. The banner reads its choice in the browser.
const marketing = await Astro.locals.app.settings.get('marketing');
const marketingToolEnabled = isMarketingToolEnabled(marketing.metaPixelId, marketing.metaCapiEnabled);
const consentLabels = {
  text: t(locale, 'consent.text'),
  accept: t(locale, 'consent.accept'),
  refuse: t(locale, 'consent.reject'),
};
---

<BaseLayout
  title={title}
  description={description}
  locale={locale}
  alternates={alternates}
  canonical={canonical}
  noindex={noindex}
  defaultLocale={defaultLocale}
  siteName={storeName}
  ogImage={ogImage}
  ogType={ogType}
  jsonLd={jsonLd}
  themeCss={themeCss}
  fontPreset={fontPreset}
  webAnalyticsToken={webAnalyticsToken}
  metaPixelId={marketing.metaPixelId}
  currency={currency}
>
  <Header storeName={storeName} locale={locale} alternates={alternates} />
  <main class="mx-auto min-h-[60dvh] max-w-6xl px-4 py-6">
    <slot />
  </main>
  <Footer storeName={storeName} locale={locale} email={contact.email} address={contact.address} />
  <MobileTabBar locale={locale} />
  {contact.showWhatsappFloat && (
    <WhatsAppFloat number={contact.whatsappNumber} message={contact.whatsappMessage} locale={locale} />
  )}
  <CartDrawer
    client:only="preact"
    locale={locale}
    currency={currency}
    country={country}
    cartHref={routes.cart(locale)}
    labels={{
      title: t(locale, 'cart.title'),
      empty: t(locale, 'cart.empty'),
      subtotal: t(locale, 'cart.subtotal'),
      remove: t(locale, 'cart.remove'),
      viewCart: t(locale, 'common.viewCart'),
      close: t(locale, 'common.close'),
    }}
  />
  <Toaster client:idle />
  <ConsentBanner
    client:idle
    mode={marketing.consentBannerMode}
    marketingToolEnabled={marketingToolEnabled}
    labels={consentLabels}
  />
</BaseLayout>
