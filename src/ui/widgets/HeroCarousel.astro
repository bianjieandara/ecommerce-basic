---
// Hero carousel: large slides with a picture, a title, a subtitle and an optional button. A slide without a picture is a
// block in the primary colour. The text sits on a dark gradient so it stays readable on any picture.
import Carousel from '@/ui/components/Carousel.astro';
import SectionPicture from '@/ui/components/SectionPicture.astro';
import { pickText, type LocalizedText } from '@/domain/shared/localized-text';
import { t } from '@/ui/i18n';
import { localizedHref } from '@/ui/lib/localized-href';
import type { WidgetProps } from './types';

interface Slide {
  image?: string | null;
  title: LocalizedText;
  subtitle: LocalizedText;
  cta?: { href: string; label: LocalizedText } | null;
}

const { section, view, data, first = false } = Astro.props as WidgetProps;
const config = section.config as { slides?: Slide[]; autoplaySeconds?: number };
const slides = config.slides ?? [];
---

{slides.length > 0 && (
  <div data-reveal>
    <Carousel
      label={t(view.locale, 'nav.home')}
      autoplay={(config.autoplaySeconds ?? 6) * 1000}
      slideBasis="100%"
      single
    >
      {slides.map((slide, index) => {
        const image = slide.image ? data.media?.[slide.image] : undefined;
        return (
          <div
            class={`relative flex min-h-104 flex-col justify-end overflow-hidden rounded-brand md:min-h-128 ${image ? 'bg-text text-white' : 'bg-primary text-on-primary'}`}
          >
            {image && (
              <>
                <SectionPicture
                  image={image}
                  sizes="(min-width: 1152px) 1152px, 100vw"
                  eager={first && index === 0}
                  class="absolute inset-0 h-full w-full object-cover object-[70%_50%]"
                />
                <div class="absolute inset-0 bg-linear-to-t from-black/75 via-black/25 to-transparent" />
              </>
            )}
            <div class="relative flex max-w-xl flex-col items-start gap-4 p-6 md:p-12">
              <h2 class="text-4xl font-medium leading-[1.05] tracking-tight text-balance md:text-6xl">
                {pickText(slide.title, view.locale, 'es')}
              </h2>
              <p class="text-base opacity-90 md:text-lg">{pickText(slide.subtitle, view.locale, 'es')}</p>
              {slide.cta && (
                <a
                  href={localizedHref(view.locale, slide.cta.href)}
                  class="inline-flex min-h-12 items-center rounded-full bg-white px-7 font-semibold text-black transition hover:bg-white/90"
                >
                  {pickText(slide.cta.label, view.locale, 'es')}
                </a>
              )}
            </div>
          </div>
        );
      })}
    </Carousel>
  </div>
)}
