---
// Benefit row: shipping, returns, secure payment and support, each with an icon and short text.
import Icon from '@/ui/components/Icon.astro';
import { pickText, type LocalizedText } from '@/domain/shared/localized-text';
import type { IconName } from '@/ui/components/icons';
import type { WidgetProps } from './types';

const { section, view } = Astro.props as WidgetProps;
const config = section.config as { items?: { icon: IconName; text: LocalizedText }[] };
// Pages saved by an earlier version named the returns icon "return"; its name is now "returns".
const items = (config.items ?? []).map((item) => ({
  ...item,
  icon: (item.icon as string) === 'return' ? ('returns' as IconName) : item.icon,
}));
---

{items.length > 0 && (
  <ul
    class="grid grid-cols-2 gap-x-4 gap-y-6 border-y border-text/10 py-7 md:grid-cols-4 md:gap-y-0 md:divide-x md:divide-text/10"
    data-reveal
  >
    {items.map((item) => (
      <li class="flex items-center gap-3 text-sm font-medium md:px-8 md:first:pl-0 md:last:pr-0">
        <Icon name={item.icon} size={22} class="shrink-0 text-accent" />
        <span>{pickText(item.text, view.locale, 'es')}</span>
      </li>
    ))}
  </ul>
)}
