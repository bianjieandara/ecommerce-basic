---
// Renders a page's sections in order. Disabled sections and types without a renderer are skipped.
// Client extensions add renderers in the UI layer (see docs/CUSTOMIZATION.md); this map holds the core types.
import type { WidgetInstance } from '@/application/content/widgets/registry';
import type { SectionData } from '@/http/page-content';
import type { StoreView } from '@/ui/lib/store-view';
import type { WhatsAppContact } from './types';
import Callout from './Callout.astro';
import CategoryGrid from './CategoryGrid.astro';
import FeaturedProducts from './FeaturedProducts.astro';
import Faq from './Faq.astro';
import HeroCarousel from './HeroCarousel.astro';
import ImageGallery from './ImageGallery.astro';
import PromoBanner from './PromoBanner.astro';
import RichText from './RichText.astro';
import Summary from './Summary.astro';
import Testimonials from './Testimonials.astro';
import TrustBadges from './TrustBadges.astro';
import WhatsAppCta from './WhatsAppCta.astro';

interface Props {
  sections: WidgetInstance[];
  data: SectionData;
  view: StoreView;
  whatsapp: WhatsAppContact;
}

const { sections, data, view, whatsapp } = Astro.props;

/** Renderer per widget type. Types not listed here render nothing. */
const renderers: Record<string, typeof HeroCarousel> = {
  hero_carousel: HeroCarousel,
  featured_products: FeaturedProducts,
  category_grid: CategoryGrid,
  promo_banner: PromoBanner,
  image_gallery: ImageGallery,
  faq: Faq,
  rich_text: RichText,
  testimonials: Testimonials,
  trust_badges: TrustBadges,
  whatsapp_cta: WhatsAppCta,
  summary: Summary,
  callout: Callout,
};
---

{sections
  .filter((section) => section.enabled)
  .map((section, index) => {
    const Renderer = renderers[section.type];
    if (!Renderer) return null;
    const node = (
      <Renderer section={section} data={data} view={view} whatsapp={whatsapp} first={index === 0} />
    );
    // The first two sections are what a visitor sees without scrolling, so they appear without the scroll-reveal fade.
    return index < 2 ? (
      <div class="contents" data-no-reveal>
        {node}
      </div>
    ) : (
      node
    );
  })}
