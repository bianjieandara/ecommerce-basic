---
// Call-to-action block that opens a WhatsApp chat with a prefilled message.
import Icon from '@/ui/components/Icon.astro';
import { pickText, type LocalizedText } from '@/domain/shared/localized-text';
import { whatsappLink } from '@/ui/lib/whatsapp';
import type { WidgetProps } from './types';

const { section, view, whatsapp } = Astro.props as WidgetProps;
const config = section.config as { title?: LocalizedText; text?: LocalizedText; buttonLabel?: LocalizedText };
const href = whatsappLink(whatsapp.number, whatsapp.message);
---

{href && (
  <section
    class="flex flex-col gap-5 rounded-card bg-surface p-6 md:flex-row md:items-center md:justify-between md:p-14"
    data-reveal
  >
    <div class="flex max-w-xl flex-col gap-3">
      <h2 class="text-xl md:text-2xl">{pickText(config.title, view.locale, 'es')}</h2>
      <p class="text-text/70 md:text-lg">{pickText(config.text, view.locale, 'es')}</p>
    </div>
    <a
      href={href}
      target="_blank"
      rel="noopener"
      class="inline-flex min-h-14 w-full shrink-0 items-center justify-center gap-2 md:w-fit rounded-full bg-primary px-8 font-semibold text-on-primary transition hover:opacity-90"
    >
      <Icon name="chat" size={20} />
      {pickText(config.buttonLabel, view.locale, 'es')}
    </a>
  </section>
)}
