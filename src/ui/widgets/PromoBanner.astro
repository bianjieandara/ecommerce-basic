---
// Promo banner: one wide picture with a headline, a line of text and a button, for an offer or a campaign.
import CtaLink from '@/ui/components/CtaLink.astro';
import SectionPicture from '@/ui/components/SectionPicture.astro';
import { pickText, type LocalizedText } from '@/domain/shared/localized-text';
import { localizedHref } from '@/ui/lib/localized-href';
import type { WidgetProps } from './types';

const { section, view, data } = Astro.props as WidgetProps;
const config = section.config as {
  image?: string | null;
  title?: LocalizedText;
  text?: LocalizedText;
  cta?: { href: string; label: LocalizedText } | null;
  align?: 'left' | 'center';
};
const image = config.image ? data.media?.[config.image] : undefined;
const centered = config.align === 'center';
---

<section
  data-reveal
  class={`relative flex min-h-80 items-center overflow-hidden rounded-card md:min-h-112 ${image ? 'bg-text text-white' : 'bg-primary text-on-primary'}`}
>
  {image && (
    <>
      <SectionPicture
        image={image}
        sizes="(min-width: 1152px) 1152px, 100vw"
        class="absolute inset-0 h-full w-full object-cover"
      />
      <div class="absolute inset-0 bg-black/45" />
    </>
  )}
  <div
    class={`relative flex w-full flex-col gap-5 p-8 md:p-16 ${centered ? 'items-center text-center' : 'items-start'}`}
  >
    <h2 class="max-w-2xl text-2xl tracking-[-0.035em] md:text-4xl">
      {pickText(config.title, view.locale, 'es')}
    </h2>
    <p class="max-w-lg text-base opacity-85 md:text-lg">{pickText(config.text, view.locale, 'es')}</p>
    {config.cta && (
      <CtaLink href={localizedHref(view.locale, config.cta.href)} tone="light">
        {pickText(config.cta.label, view.locale, 'es')}
      </CtaLink>
    )}
  </div>
</section>
