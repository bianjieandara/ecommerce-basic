---
// Map placeholder. Nothing is requested from Google until the visitor asks for the map.
interface Props {
  src: string;
  title: string;
  hint: string;
  openLabel: string;
}

const { src, title, hint, openLabel } = Astro.props;
---

{src && (
  <div
    class="rounded-card bg-surface flex min-h-64 flex-col items-center justify-center gap-4 p-6 text-center"
    data-map-facade
    data-src={src}
    data-title={title}
  >
    <p class="text-text/70 max-w-sm text-sm">{hint}</p>
    <button
      type="button"
      class="bg-primary text-on-primary min-h-12 rounded-full px-7 font-medium transition hover:opacity-90"
      data-map-open
    >
      {openLabel}
    </button>
  </div>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-map-facade]').forEach((facade) => {
    facade.querySelector('[data-map-open]')?.addEventListener('click', () => {
      const frame = document.createElement('iframe');
      frame.src = facade.dataset.src ?? '';
      frame.title = facade.dataset.title ?? '';
      frame.className = 'h-96 w-full rounded-card';
      frame.loading = 'lazy';
      frame.referrerPolicy = 'no-referrer-when-downgrade';
      facade.replaceChildren(frame);
    });
  });
</script>
