---
// Empty list or search result: icon, title and an optional explanation.
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  title: string;
  text?: string;
  icon?: IconName;
}

const { title, text, icon = 'grid' } = Astro.props;
---

<div class="flex animate-slide-up flex-col items-center gap-4 px-6 py-20 text-center">
  <span class="flex size-16 items-center justify-center rounded-full bg-surface text-text/60">
    <Icon name={icon} size={28} />
  </span>
  <h2 class="text-xl md:text-2xl">{title}</h2>
  {text && <p class="max-w-sm text-text/65">{text}</p>}
  <slot />
</div>
