---
// Empty list or search result: icon, title and an optional explanation.
import Icon from './Icon.astro';
import type { IconName } from './icons';

interface Props {
  title: string;
  text?: string;
  icon?: IconName;
}

const { title, text, icon = 'grid' } = Astro.props;
---

<div class="flex animate-slide-up flex-col items-center gap-3 px-6 py-12 text-center">
  <Icon name={icon} size={40} class="text-text/40" />
  <h2 class="text-lg font-semibold">{title}</h2>
  {text && <p class="max-w-sm text-sm text-text/70">{text}</p>}
  <slot />
</div>
