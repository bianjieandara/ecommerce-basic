---
// Native <select> with the store's own chevron in place of the browser's arrow. The control keeps its native behaviour
// (keyboard, the phone's picker, form submission); only the drawing changes. Options go in the default slot.
import Icon from './Icon.astro';

interface Props {
  id: string;
  name: string;
  /** "field" matches the text inputs of a form; "pill" is the compact rounded control used for sorting. */
  shape?: 'field' | 'pill';
  required?: boolean;
  disabled?: boolean;
  describedBy?: string;
  /** Submits the form when the choice changes. Done by `initSelects` (ui/scripts/select.ts), because a page policy refuses inline handlers. */
  submitOnChange?: boolean;
  class?: string;
}

const {
  id,
  name,
  shape = 'field',
  required = false,
  disabled = false,
  describedBy,
  submitOnChange = false,
  class: className = '',
} = Astro.props;
const shapes = {
  field: 'min-h-12 w-full rounded-brand text-base',
  pill: 'min-h-11 rounded-full text-sm',
};
---

<div class={`relative ${shape === 'field' ? 'w-full' : ''}`}>
  <select
    id={id}
    name={name}
    required={required}
    disabled={disabled}
    aria-describedby={describedBy}
    data-submit-on-change={submitOnChange ? '' : undefined}
    class={`${shapes[shape]} border-text/15 bg-background text-text hover:border-text/40 focus:border-text cursor-pointer appearance-none border py-2 pr-11 pl-4 transition-colors disabled:opacity-50 ${className}`}
  >
    <slot />
  </select>
  <Icon
    name="chevronDown"
    size={18}
    class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 opacity-70"
  />
</div>
