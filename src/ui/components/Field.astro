---
// Form field wrapper: label, optional hint, and an error message wired to the control with aria-describedby.
// The control itself goes in the default slot (an <input>, <select> or <textarea> with `id` and `aria-describedby`).
interface Props {
  id: string;
  label: string;
  hint?: string;
  error?: string | null;
  required?: boolean;
  class?: string;
}

const { id, label, hint, error = null, required = false, class: className = '' } = Astro.props;
---

<div class={`flex flex-col gap-1.5 ${className}`}>
  <label for={id} class="text-sm font-medium text-text">
    {label}
    {required && (
      <span class="text-accent" aria-hidden="true">
        {' '}
        *
      </span>
    )}
  </label>
  <slot />
  {hint && (
    <p id={`${id}-hint`} class="text-xs text-text/60">
      {hint}
    </p>
  )}
  {error && (
    <p id={`${id}-error`} role="alert" class="text-xs font-medium text-accent">
      {error}
    </p>
  )}
</div>
