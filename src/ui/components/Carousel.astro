---
// Carousel shell: a scroll-snap track with prev/next buttons and dots. Slides are passed in the default slot as
// direct children of the track. Behaviour lives in ui/scripts/carousel.ts (initialized by BaseLayout).
import Icon from './Icon.astro';

interface Props {
  /** Accessible name of the region, for example "Featured products". */
  label: string;
  /** Accessible names of the two arrow buttons, in the page language. */
  previousLabel: string;
  nextLabel: string;
  /** Autoplay delay in milliseconds; 0 disables autoplay. */
  autoplay?: number;
  /** Slides per view on small screens, as a CSS basis (for example "85%"). */
  slideBasis?: string;
  /** One slide at a time on every screen size, for banners. Without it a laptop shows three slides side by side. */
  single?: boolean;
  /** Controls float over the bottom-right corner of the slides (banners) instead of sitting in a row below them. */
  overlay?: boolean;
  class?: string;
}

const {
  label,
  previousLabel,
  nextLabel,
  autoplay = 6000,
  slideBasis = '85%',
  single = false,
  overlay = false,
  class: className = '',
} = Astro.props;
const arrow =
  'inline-flex min-h-11 min-w-11 items-center justify-center rounded-full border border-text/15 transition hover:bg-text hover:text-background';
---

<section
  data-carousel
  data-carousel-single={single ? '' : undefined}
  data-autoplay={autoplay}
  aria-roledescription="carousel"
  aria-label={label}
  class={`relative ${className}`}
>
  <div
    data-carousel-track
    class="flex snap-x snap-mandatory gap-4 overflow-x-auto scroll-smooth pb-2 [scrollbar-width:none] [&::-webkit-scrollbar]:hidden"
    style={`--slide-basis:${slideBasis}`}
  >
    <slot />
  </div>
  <div
    data-carousel-controls
    class={
      overlay
        ? 'absolute bottom-4 right-4 flex items-center gap-1 rounded-full bg-background/90 p-1 shadow-sm backdrop-blur md:bottom-6 md:right-6'
        : 'mt-4 flex items-center gap-2'
    }
  >
    <div
      data-carousel-dots
      class="flex min-w-0 flex-1 items-center justify-start overflow-x-auto scrollbar-none [&::-webkit-scrollbar]:hidden"
    ></div>
    <button type="button" data-carousel-prev class={arrow} aria-label={previousLabel}>
      <Icon name="arrow-left" size={18} />
    </button>
    <button type="button" data-carousel-next class={arrow} aria-label={nextLabel}>
      <Icon name="arrow-right" size={18} />
    </button>
  </div>
</section>

<style>
  /* The slides come from the page that uses the carousel, not from this component, so the rule must be global. A scoped
     rule would never reach them, and the slides would collapse onto each other. */
  :global([data-carousel-track] > *) {
    flex: 0 0 var(--slide-basis);
    scroll-snap-align: start;
  }
  @media (min-width: 768px) {
    :global([data-carousel-track] > *) {
      flex-basis: calc((100% - 2 * 1rem) / 3);
    }
    :global([data-carousel-single] [data-carousel-track] > *) {
      flex-basis: 100%;
    }
  }
</style>
