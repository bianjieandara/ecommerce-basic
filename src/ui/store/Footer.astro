---
// Store footer on an inverted (dark) surface: the store's name and contact details, the main links, the legal links and the
// copyright. Three columns on a laptop, stacked on a phone. Bottom padding leaves room for the mobile tab bar.
import { t } from '@/ui/i18n';
import { routes } from '@/ui/lib/routes';
import type { Locale } from '@/domain/shared/locale';
import ConsentSettingsLink from './ConsentSettingsLink.tsx';

interface Props {
  storeName: string;
  locale: Locale;
  email?: string;
  address?: string;
}

const { storeName, locale, email = '', address = '' } = Astro.props;
const year = new Date().getFullYear();
// Text and background swap roles here, so links use the page background colour at reduced opacity.
const link =
  'inline-flex min-h-11 items-center text-sm text-background/75 underline-offset-4 hover:text-background hover:underline';
const heading = 'text-xs font-semibold uppercase tracking-wider text-background/75';
---

<footer class="mt-20 bg-text pb-24 text-background md:pb-10">
  <div class="mx-auto grid max-w-6xl gap-10 px-4 py-12 md:grid-cols-[2fr_1fr_1fr]">
    <div class="flex flex-col gap-3">
      <p class="text-lg font-semibold tracking-tight">{storeName}</p>
      {address && <p class="max-w-xs text-sm text-background/70">{address}</p>}
      {email && (
        <a href={`mailto:${email}`} class={link}>
          {email}
        </a>
      )}
    </div>
    <nav aria-label={t(locale, 'nav.menu')} class="flex flex-col items-start gap-1">
      <p class={`${heading} mb-2`}>{t(locale, 'nav.menu')}</p>
      <a href={routes.shop(locale)} class={link}>
        {t(locale, 'nav.shop')}
      </a>
      <a href={routes.contact(locale)} class={link}>
        {t(locale, 'nav.contact')}
      </a>
    </nav>
    <nav aria-label={t(locale, 'footer.legal')} class="flex flex-col items-start gap-1">
      <p class={`${heading} mb-2`}>{t(locale, 'footer.legal')}</p>
      <a href={routes.page(locale, 'privacy')} class={link}>
        {t(locale, 'footer.privacy')}
      </a>
      <a href={routes.page(locale, 'terms')} class={link}>
        {t(locale, 'footer.terms')}
      </a>
      <a href={routes.page(locale, 'shipping-returns')} class={link}>
        {t(locale, 'footer.shippingReturns')}
      </a>
      <ConsentSettingsLink client:idle label={t(locale, 'consent.settings')} />
    </nav>
  </div>
  <div class="border-t border-background/20">
    <p class="mx-auto max-w-6xl px-4 py-5 text-sm text-background/75">
      © {year} {storeName}. {t(locale, 'footer.rights')}
    </p>
  </div>
</footer>
