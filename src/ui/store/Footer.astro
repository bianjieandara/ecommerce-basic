---
// Compact store footer on an inverted (dark) surface: the store's name and contact details, the link columns and the
// copyright. The columns come from one list, so a new column is one more entry. Bottom padding leaves room for the mobile
// tab bar.
import FooterLink from './FooterLink.astro';
import { t } from '@/ui/i18n';
import { routes } from '@/ui/lib/routes';
import type { Locale } from '@/domain/shared/locale';
import ConsentSettingsLink from './ConsentSettingsLink.tsx';

interface Props {
  storeName: string;
  locale: Locale;
  email?: string;
  address?: string;
}

const { storeName, locale, email = '', address = '' } = Astro.props;
const year = new Date().getFullYear();
const columns = [
  {
    title: t(locale, 'nav.menu'),
    links: [
      { href: routes.shop(locale), label: t(locale, 'nav.shop') },
      { href: routes.contact(locale), label: t(locale, 'nav.contact') },
    ],
    consent: false,
  },
  {
    title: t(locale, 'footer.legal'),
    links: [
      { href: routes.page(locale, 'privacy'), label: t(locale, 'footer.privacy') },
      { href: routes.page(locale, 'terms'), label: t(locale, 'footer.terms') },
      { href: routes.page(locale, 'shipping-returns'), label: t(locale, 'footer.shippingReturns') },
    ],
    // The privacy settings control is a button, not a page, so it closes this column instead of being a link in the list.
    consent: true,
  },
];
---

<footer class="mt-12 bg-text pb-20 text-background md:mt-20 md:pb-0">
  <div class="mx-auto grid max-w-7xl grid-cols-2 gap-x-6 gap-y-6 px-5 py-8 md:grid-cols-[2fr_1fr_1fr] md:gap-12 md:px-8 md:py-10">
    <div class="col-span-2 flex flex-col gap-1 md:col-span-1">
      <p class="font-display text-xl font-semibold tracking-tight">{storeName}</p>
      {address && <p class="max-w-xs text-sm text-background/70">{address}</p>}
      {email && (
        <FooterLink href={`mailto:${email}`} class="w-fit">
          {email}
        </FooterLink>
      )}
    </div>
    {columns.map((column) => (
      <nav aria-label={column.title} class="flex flex-col items-start">
        <p class="eyebrow mb-1 text-background/50!">{column.title}</p>
        {column.links.map((link) => (
          <FooterLink href={link.href}>{link.label}</FooterLink>
        ))}
        {column.consent && <ConsentSettingsLink client:idle label={t(locale, 'consent.settings')} />}
      </nav>
    ))}
  </div>
  <div class="border-t border-background/15">
    <p class="mx-auto max-w-7xl px-5 py-3 text-xs text-background/60 md:px-8">
      © {year} {storeName}. {t(locale, 'footer.rights')}
    </p>
  </div>
</footer>
