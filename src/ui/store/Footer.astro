---
// Store footer on an inverted (dark) surface: the store's name and contact details, the main links, the legal links, the
// copyright and the store's name again as an oversized, faint wordmark. Three columns on a laptop, stacked on a phone.
// Bottom padding leaves room for the mobile tab bar.
import { t } from '@/ui/i18n';
import { routes } from '@/ui/lib/routes';
import type { Locale } from '@/domain/shared/locale';
import ConsentSettingsLink from './ConsentSettingsLink.tsx';

interface Props {
  storeName: string;
  locale: Locale;
  email?: string;
  address?: string;
}

const { storeName, locale, email = '', address = '' } = Astro.props;
const year = new Date().getFullYear();
// Text and background swap roles here, so links use the page background colour at reduced opacity.
const link =
  'inline-flex min-h-11 min-w-11 items-center text-sm text-background/70 underline-offset-4 transition hover:text-background hover:underline';
const heading = 'eyebrow mb-3 !text-background/50';
---

<footer class="mt-24 overflow-hidden bg-text pb-20 text-background md:mt-32 md:pb-0">
  <div class="mx-auto grid max-w-7xl gap-12 px-5 pt-16 md:grid-cols-[2fr_1fr_1fr] md:px-8 md:pt-20">
    <div class="flex flex-col gap-4">
      <p class="font-display text-2xl font-semibold tracking-tight">{storeName}</p>
      {address && <p class="max-w-xs text-sm text-background/70">{address}</p>}
      {email && (
        <a href={`mailto:${email}`} class={`${link} w-fit`}>
          {email}
        </a>
      )}
    </div>
    <nav aria-label={t(locale, 'nav.menu')} class="flex flex-col items-start">
      <p class={heading}>{t(locale, 'nav.menu')}</p>
      <a href={routes.shop(locale)} class={link}>
        {t(locale, 'nav.shop')}
      </a>
      <a href={routes.contact(locale)} class={link}>
        {t(locale, 'nav.contact')}
      </a>
    </nav>
    <nav aria-label={t(locale, 'footer.legal')} class="flex flex-col items-start">
      <p class={heading}>{t(locale, 'footer.legal')}</p>
      <a href={routes.page(locale, 'privacy')} class={link}>
        {t(locale, 'footer.privacy')}
      </a>
      <a href={routes.page(locale, 'terms')} class={link}>
        {t(locale, 'footer.terms')}
      </a>
      <a href={routes.page(locale, 'shipping-returns')} class={link}>
        {t(locale, 'footer.shippingReturns')}
      </a>
      <ConsentSettingsLink client:idle label={t(locale, 'consent.settings')} />
    </nav>
  </div>
  <div class="mx-auto mt-16 max-w-7xl border-t border-background/15 px-5 py-5 md:px-8">
    <p class="text-sm text-background/60">
      © {year} {storeName}. {t(locale, 'footer.rights')}
    </p>
  </div>
  {/* Decorative: the name repeated at the width of the page. Hidden from screen readers, which already read it above. */}
  <p
    aria-hidden="true"
    class="pointer-events-none -mb-[0.14em] select-none whitespace-nowrap text-center font-display text-[17vw] font-semibold leading-[0.8] tracking-tighter text-background/[0.07] max-md:hidden"
  >
    {storeName}
  </p>
</footer>
