---
// "You may also like" row of the product page: products from the same categories, as a carousel of cards. Renders nothing when
// there are none, so a product alone in its category shows no empty heading.
import Carousel from '@/ui/components/Carousel.astro';
import { t } from '@/ui/i18n';
import type { ProductCardDto } from '@/application/dto/catalog-dto';
import type { StoreView } from '@/ui/lib/store-view';
import ProductCard from './ProductCard.astro';

interface Props {
  products: ProductCardDto[];
  view: StoreView;
}

const { products, view } = Astro.props;
---

{products.length > 0 && (
  <section class="mt-20 flex flex-col gap-8 md:mt-28" aria-labelledby="related-heading">
    <h2 id="related-heading" class="text-xl md:text-2xl">
      {t(view.locale, 'product.related')}
    </h2>
    <Carousel
      label={t(view.locale, 'product.related')}
      previousLabel={t(view.locale, 'nav.previous')}
      nextLabel={t(view.locale, 'nav.next')}
    >
      {products.map((product) => (
        <div class="w-44 shrink-0 snap-start sm:w-56">
          <ProductCard product={product} view={view} />
        </div>
      ))}
    </Carousel>
  </section>
)}
