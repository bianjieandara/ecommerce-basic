---
// Sticky store header: logo, desktop navigation, search link, language switcher and the cart button with its count.
import Icon from '@/ui/components/Icon.astro';
import { t } from '@/ui/i18n';
import { routes } from '@/ui/lib/routes';
import type { Locale } from '@/domain/shared/locale';

interface Props {
  storeName: string;
  locale: Locale;
  alternates?: Partial<Record<Locale, string>>;
}

const { storeName, locale, alternates = {} } = Astro.props;
const other: Locale = locale === 'es' ? 'en' : 'es';
const otherHref = alternates[other] ?? (other === 'es' ? '/es/' : '/en/');
---

<header class="sticky top-0 z-30 border-b border-text/10 bg-background/95 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-3 px-4">
    <a href={routes.home(locale)} class="font-semibold tracking-tight">
      {storeName}
    </a>
    <nav aria-label="Main" class="ml-6 hidden items-center gap-5 text-sm md:flex">
      <a href={routes.shop(locale)} class="hover:text-accent">
        {t(locale, 'nav.shop')}
      </a>
      <a href={routes.contact(locale)} class="hover:text-accent">
        {t(locale, 'nav.contact')}
      </a>
    </nav>
    <div class="ml-auto flex items-center gap-1">
      <a
        href={`${routes.shop(locale)}?q=`}
        class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full hover:bg-surface"
        aria-label={t(locale, 'nav.search')}
      >
        <Icon name="search" />
      </a>
      <a
        href={otherHref}
        hreflang={other}
        class="inline-flex min-h-11 items-center rounded-full px-3 text-sm font-medium hover:bg-surface"
        aria-label={t(locale, 'nav.language')}
      >
        {other.toUpperCase()}
      </a>
      <a
        href={routes.cart(locale)}
        class="relative inline-flex min-h-11 min-w-11 items-center justify-center rounded-full hover:bg-surface"
        aria-label={t(locale, 'nav.cart')}
      >
        <Icon name="cart" />
        <span
          data-cart-count
          class="absolute -right-0.5 -top-0.5 hidden min-w-5 rounded-full bg-accent px-1 text-center text-xs font-bold text-on-primary"
        ></span>
      </a>
    </div>
  </div>
</header>
