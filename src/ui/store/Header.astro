---
// Store header: an optional announcement strip (it scrolls away), then the sticky bar with the logo, desktop navigation,
// search link, language switcher and the cart button with its count.
import Icon from '@/ui/components/Icon.astro';
import CartBadge from './CartBadge.tsx';
import SearchOverlay from './SearchOverlay.tsx';
import { t } from '@/ui/i18n';
import { routes } from '@/ui/lib/routes';
import type { Locale } from '@/domain/shared/locale';

interface Props {
  storeName: string;
  locale: Locale;
  alternates?: Partial<Record<Locale, string>>;
  /** Query string (with its "?") the language link keeps, for pages whose filters mean the same in both languages. */
  switchSearch?: string;
  /** Text of the strip above the bar, in the page's language. Empty renders no strip. */
  announcement?: string;
}

const { storeName, locale, alternates = {}, switchSearch = '', announcement = '' } = Astro.props;
const other: Locale = locale === 'es' ? 'en' : 'es';
const otherHref = `${alternates[other] ?? (other === 'es' ? '/es/' : '/en/')}${switchSearch}`;
const navLink = 'inline-flex min-h-11 items-center text-text/70 transition hover:text-text';
---

{announcement && (
  <p class="bg-primary px-5 py-2 text-center text-[11px] font-medium uppercase tracking-[0.16em] text-on-primary">
    {announcement}
  </p>
)}
<header class="sticky top-0 z-30 border-b border-text/10 bg-background/90 backdrop-blur-md">
  <div class="mx-auto flex h-16 max-w-7xl items-center gap-4 px-5 md:h-[4.5rem] md:px-8">
    <a
      href={routes.home(locale)}
      class="inline-flex min-h-11 items-center font-display text-xl font-semibold tracking-tight"
    >
      {storeName}
    </a>
    <nav
      aria-label={t(locale, 'nav.main')}
      class="ml-8 hidden items-center gap-8 text-sm font-medium md:flex"
    >
      <a href={routes.shop(locale)} class={navLink}>
        {t(locale, 'nav.shop')}
      </a>
      <a href={routes.contact(locale)} class={navLink}>
        {t(locale, 'nav.contact')}
      </a>
    </nav>
    <div class="ml-auto flex items-center gap-1">
      <SearchOverlay
        client:idle
        locale={locale}
        shopHref={routes.shop(locale)}
        labels={{
          open: t(locale, 'nav.search'),
          close: t(locale, 'common.close'),
          placeholder: t(locale, 'shop.searchPlaceholder'),
        }}
      />
      <a
        href={otherHref}
        hreflang={other}
        class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full px-3 text-xs font-semibold tracking-wider hover:bg-surface"
        aria-label={`${other.toUpperCase()} ${t(locale, 'nav.language')}`}
      >
        {other.toUpperCase()}
      </a>
      <a
        href={routes.cart(locale)}
        class="relative inline-flex min-h-11 min-w-11 items-center justify-center rounded-full hover:bg-surface"
        aria-label={t(locale, 'nav.cart')}
      >
        <Icon name="cart" />
        <CartBadge client:only="preact" />
      </a>
    </div>
  </div>
</header>
