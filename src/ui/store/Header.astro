---
// Store header: an optional announcement strip (it scrolls away), then the sticky bar with the logo, desktop navigation,
// search link, language switcher and the cart button with its count.
import Icon from '@/ui/components/Icon.astro';
import CartBadge from './CartBadge.tsx';
import SearchOverlay from './SearchOverlay.tsx';
import { t } from '@/ui/i18n';
import { routes } from '@/ui/lib/routes';
import type { Locale } from '@/domain/shared/locale';

interface Props {
  storeName: string;
  locale: Locale;
  alternates?: Partial<Record<Locale, string>>;
  /** Text of the strip above the bar, in the page's language. Empty renders no strip. */
  announcement?: string;
}

const { storeName, locale, alternates = {}, announcement = '' } = Astro.props;
const other: Locale = locale === 'es' ? 'en' : 'es';
const otherHref = alternates[other] ?? (other === 'es' ? '/es/' : '/en/');
---

{announcement && (
  <p class="bg-primary px-4 py-2 text-center text-xs tracking-wide text-on-primary">{announcement}</p>
)}
<header class="sticky top-0 z-30 border-b border-text/10 bg-background/95 backdrop-blur">
  <div class="mx-auto flex h-14 max-w-6xl items-center gap-3 px-4">
    <a href={routes.home(locale)} class="inline-flex min-h-11 items-center font-semibold tracking-tight">
      {storeName}
    </a>
    <nav aria-label="Main" class="ml-6 hidden items-center gap-5 text-sm md:flex">
      <a href={routes.shop(locale)} class="hover:text-accent">
        {t(locale, 'nav.shop')}
      </a>
      <a href={routes.contact(locale)} class="hover:text-accent">
        {t(locale, 'nav.contact')}
      </a>
    </nav>
    <div class="ml-auto flex items-center gap-1">
      <SearchOverlay
        client:idle
        locale={locale}
        shopHref={routes.shop(locale)}
        labels={{
          open: t(locale, 'nav.search'),
          close: t(locale, 'common.close'),
          placeholder: t(locale, 'shop.searchPlaceholder'),
        }}
      />
      <a
        href={otherHref}
        hreflang={other}
        class="inline-flex min-h-11 min-w-11 items-center justify-center rounded-full px-3 text-sm font-medium hover:bg-surface"
        aria-label={`${other.toUpperCase()} ${t(locale, 'nav.language')}`}
      >
        {other.toUpperCase()}
      </a>
      <a
        href={routes.cart(locale)}
        class="relative inline-flex min-h-11 min-w-11 items-center justify-center rounded-full hover:bg-surface"
        aria-label={t(locale, 'nav.cart')}
      >
        <Icon name="cart" />
        <CartBadge client:only="preact" />
      </a>
    </div>
  </div>
</header>
