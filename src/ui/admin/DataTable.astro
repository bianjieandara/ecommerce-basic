---
// Table for admin lists. Cells carry a data-label; below the md breakpoint each row turns into a card (see
// ui/styles/admin-table.css), so one set of markup serves the phone and the desktop.
import { TABLE_WRAP } from './lib/classes';
---

<div class={TABLE_WRAP}>
  <table class="admin-table w-full text-sm">
    <slot />
  </table>
</div>
