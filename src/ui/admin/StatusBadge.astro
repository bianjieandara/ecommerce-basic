---
// Small status label. The tone decides the colour; the text is always passed in, already translated.
import { BADGE, BADGE_TONE } from './lib/classes';

interface Props {
  label: string;
  tone?: keyof typeof BADGE_TONE;
}

const { label, tone = 'muted' } = Astro.props;
---

<span class={`${BADGE} ${BADGE_TONE[tone]}`}>{label}</span>
