---
// Filter bar for admin lists. It is a plain GET form, so filters live in the URL: the list works without JavaScript and a
// filtered view can be bookmarked or shared.
import { BUTTON, BUTTON_PRIMARY, FIELD, LABEL } from './lib/classes';

interface Props {
  action: string;
  search: string;
  labels: { search: string; apply: string; clear: string };
  /** Where "clear" goes: the list without filters. */
  clearHref: string;
}

const { action, search, labels, clearHref } = Astro.props;
---

<form
  method="get"
  action={action}
  class="rounded-brand bg-surface flex flex-col gap-3 p-4 sm:flex-row sm:flex-wrap sm:items-end"
>
  <label class={`${LABEL} sm:min-w-64 sm:flex-1`}>
    {labels.search}
    <input type="search" name="q" value={search} class={FIELD} />
  </label>
  <slot />
  <div class="flex gap-2">
    <button type="submit" class={BUTTON_PRIMARY}>
      {labels.apply}
    </button>
    <a href={clearHref} class={BUTTON}>
      {labels.clear}
    </a>
  </div>
</form>
