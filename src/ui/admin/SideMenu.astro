---
// A list of links with the open one marked: a column beside the content on a wide screen, a scrolling row on a phone. Used for
// the settings groups and the reports, so both lists look and behave the same.
interface Props {
  label: string;
  items: { href: string; label: string; current: boolean }[];
}

const { label, items } = Astro.props;
---

<nav
  aria-label={label}
  class="-mx-4 flex gap-1 overflow-x-auto px-4 lg:mx-0 lg:flex-col lg:overflow-visible lg:px-0"
>
  {items.map((item) => (
    <a
      href={item.href}
      aria-current={item.current ? 'page' : undefined}
      class="inline-flex min-h-11 shrink-0 items-center rounded-xl px-4 text-sm font-medium text-text/70 transition-colors hover:bg-surface hover:text-text aria-[current=page]:bg-surface aria-[current=page]:font-semibold aria-[current=page]:text-text"
    >
      {item.label}
    </a>
  ))}
</nav>
