---
// Order status page. The link from the confirmation carries the access key. Without a matching key nothing is shown.
import StoreLayout from '@/ui/layouts/StoreLayout.astro';
import { formatDateTime, formatMoney } from '@/domain/shared/format';
import { isLocale } from '@/domain/shared/locale';
import { pickText } from '@/domain/shared/localized-text';
import { money } from '@/domain/shared/money';
import { PATHS } from '@/domain/shared/paths';
import { pickNamespace, t, type DotPath } from '@/ui/i18n';
import { renderMarkdown } from '@/ui/lib/markdown';
import { orderEventLabel } from '@/ui/lib/order-event-label';
import { purchaseAttribute } from '@/ui/lib/track-order';
import { whatsappLink } from '@/ui/lib/whatsapp';
import { loadStoreContext } from '@/http/store-context';
import PaymentReceiptForm from '@/ui/store/PaymentReceiptForm.tsx';
import { paymentInstructions } from '@/application/ordering/order-sections';
import { MAX_RECEIPT_BYTES, RECEIPT_TYPES } from '@/domain/ordering/payment-receipt';
import type { InstructedMethod } from '@/application/ports/payments';
import { buildTitle, contactFor, storeViewFor } from '@/http/storefront';
import { themeToCss } from '@/ui/lib/theme-css';

// Order data is personal and changes with payments, so it is never cached.
Astro.response.headers.set('Cache-Control', 'no-store');
const { locale, number: rawNumber } = Astro.params;
if (!isLocale(locale ?? '')) return Astro.rewrite('/404');
const lang = locale as 'es' | 'en';
const app = Astro.locals.app;
const number = Number(rawNumber);
const key = Astro.url.searchParams.get('key') ?? '';
const found = Number.isInteger(number) && number > 0 ? await app.orderStatus.execute(number, key) : null;
if (!found) Astro.response.status = 404;

const store = await loadStoreContext(app);
const view = storeViewFor(store, lang);
const contact = contactFor(store, lang);
const checkout = await app.settings.get('checkout');
const title = found
  ? t(lang, 'order.number', { number: String(found.order.number) })
  : t(lang, 'order.viewOrder');
const price = (amountMinor: number) => formatMoney(money(amountMinor, view.currency), lang, view.country);
// Demo mode only: the e-mails the store wrote for this order (kept in the outbox, opened with the same key as this page).
const orderEmails = app.demo.enabled && found ? await app.demo.orderEmails.list(number, key) : null;
// Orders stored before a gateway change may carry a method with no label any more; such a line is left out.
const checkoutMethods = pickNamespace(lang, 'checkout').methods;

const pending = found?.order.status === 'pending_payment';
// Methods the buyer pays by hand: one block shows the store's instructions, with the notice that belongs to each.
const HELP_OF: Record<InstructedMethod, DotPath> = {
  bank_transfer: 'order.bankHelp',
  deuna: 'order.deunaHelp',
};
const method = found?.order.paymentMethod ?? '';
const instructions = paymentInstructions(checkout, method);
// The limit is announced in the text the buyer reads, so the form never promises more than the server takes.
const receiptMb = String(Math.round(MAX_RECEIPT_BYTES / (1024 * 1024)));
const receiptLabels = {
  title: t(lang, 'order.receiptTitle'),
  intro: t(lang, 'order.receiptIntro'),
  file: t(lang, 'order.receiptFile', { mb: receiptMb }),
  submit: t(lang, 'order.receiptSubmit'),
  sending: t(lang, 'order.receiptSending'),
  done: t(lang, 'order.receiptDone'),
  uploaded: t(lang, 'order.receiptUploaded'),
  view: t(lang, 'order.receiptView'),
  replace: t(lang, 'order.receiptReplace'),
  error: t(lang, 'order.receiptError'),
  tooLarge: t(lang, 'order.receiptTooLarge', { mb: receiptMb }),
  wrongType: t(lang, 'order.receiptWrongType'),
  unavailable: t(lang, 'order.receiptUnavailable'),
  rateLimited: t(lang, 'order.receiptRateLimited'),
};
// The browser reports the purchase from this attribute, only while the order is paid and recent (see ui/lib/track-order.ts).
const purchase = found ? purchaseAttribute(found.order, Date.now()) : null;
const storeChat = found ? whatsappLink(contact.whatsappNumber, `${contact.whatsappMessage} #${number}`) : '';
---

<StoreLayout
  title={buildTitle(store, lang, title)}
  locale={lang}
  storeName={store.general.storeName}
  currency={view.currency}
  country={view.country}
  alternates={{ es: PATHS.shop('es'), en: PATHS.shop('en') }}
  canonical={new URL(PATHS.shop(lang), Astro.url.origin).toString()}
  noindex={true}
  themeCss={themeToCss(store.theme)}
  fontPreset={store.theme.fontPreset}
  contact={contact}
>
  {found ? (
    <article class="flex flex-col gap-8">
      {purchase && <div hidden data-purchase={purchase} />}
      <header class="flex flex-col gap-2">
        <h1 class="text-2xl md:text-3xl">{title}</h1>
        <p class="text-sm">
          {t(lang, 'order.status')}: <strong>{t(lang, `order.statuses.${found.order.status}`)}</strong>
        </p>
      </header>

      {pending && instructions && (
        <div class="rounded-brand bg-surface flex flex-col gap-2 p-4 text-sm">
          <p>{t(lang, HELP_OF[method as InstructedMethod])}</p>
          <div set:html={renderMarkdown(pickText(instructions, lang, 'es'))} />
        </div>
      )}
      {pending && instructions && found && (
        <PaymentReceiptForm
          client:visible
          orderNumber={found.order.number}
          accessKey={key}
          accept={RECEIPT_TYPES.join(',')}
          maxBytes={MAX_RECEIPT_BYTES}
          hasReceipt={found.order.paymentReceiptKey !== null}
          labels={receiptLabels}
        />
      )}
      {pending && found.order.paymentMethod === 'cash_on_delivery' && (
        <div class="rounded-brand bg-surface flex flex-col gap-2 p-4 text-sm">
          <p>{t(lang, 'order.codHelp')}</p>
          {pickText(checkout.cashOnDeliveryNote, lang, 'es') && (
            <div set:html={renderMarkdown(pickText(checkout.cashOnDeliveryNote, lang, 'es'))} />
          )}
        </div>
      )}
      {pending && found.order.paymentMethod === 'whatsapp' && storeChat && (
        <a
          href={storeChat}
          class="rounded-brand bg-primary text-on-primary inline-flex min-h-12 w-fit items-center px-5 font-semibold"
        >
          {t(lang, 'order.whatsappAction')}
        </a>
      )}

      {found.invoiceNumber && (
        <p class="text-sm">
          <a
            href={`/api/orders/${found.order.number}/invoice.pdf?key=${encodeURIComponent(key)}`}
            class="underline"
          >
            {t(lang, 'order.downloadInvoice')} · {found.invoiceNumber}
          </a>
        </p>
      )}

      <section class="flex flex-col gap-3" aria-labelledby="order-items">
        <h2 id="order-items" class="text-lg font-semibold">
          {t(lang, 'order.items')}
        </h2>
        <ul class="flex flex-col gap-3 text-sm">
          {found.order.items.map((item) => (
            <li class="border-text/10 flex justify-between gap-3 border-b pb-3">
              <span>
                {item.quantity} × {item.productName}
                {item.variantLabel && <span class="text-text/70"> · {item.variantLabel}</span>}
              </span>
              <span>{price(item.lineTotalMinor)}</span>
            </li>
          ))}
        </ul>
        <dl class="flex flex-col gap-2 text-sm">
          <div class="flex justify-between">
            <dt>{t(lang, 'cart.subtotal')}</dt>
            <dd>{price(found.order.subtotalMinor)}</dd>
          </div>
          <div class="flex justify-between">
            <dt>{t(lang, 'cart.tax')}</dt>
            <dd>{price(found.order.taxMinor)}</dd>
          </div>
          <div class="flex justify-between">
            <dt>{t(lang, 'order.shipping')}</dt>
            <dd>{price(found.order.shippingMinor)}</dd>
          </div>
          <div class="border-text/10 flex justify-between border-t pt-2 text-base font-semibold">
            <dt>{t(lang, 'order.total')}</dt>
            <dd>{price(found.order.totalMinor)}</dd>
          </div>
        </dl>
      </section>

      <section class="flex flex-col gap-2 text-sm" aria-labelledby="order-payment">
        <h2 id="order-payment" class="text-lg font-semibold">
          {t(lang, 'order.paymentMethod')}
        </h2>
        {checkoutMethods[found.order.paymentMethod] && <p>{checkoutMethods[found.order.paymentMethod]}</p>}
        {Object.values(found.order.shippingAddress).some(Boolean) && (
          <>
            <h3 class="pt-2 font-semibold">{t(lang, 'order.address')}</h3>
            <p>{Object.values(found.order.shippingAddress).filter(Boolean).join(', ')}</p>
          </>
        )}
      </section>

      {orderEmails && (
        <section class="flex flex-col gap-2 text-sm" aria-labelledby="order-emails">
          <h2 id="order-emails" class="text-lg font-semibold">
            {t(lang, 'demo.emailsTitle')}
          </h2>
          {orderEmails.length === 0 ? (
            <p class="text-text/70">{t(lang, 'demo.emailsEmpty')}</p>
          ) : (
            <ul class="flex flex-col gap-2">
              {orderEmails.map((email) => (
                <li class="flex flex-wrap items-center justify-between gap-2 rounded-card bg-surface px-4 py-2">
                  <span>
                    {email.subject} ·{' '}
                    {formatDateTime(email.sentAt, lang, view.country, store.general.timezone)}
                  </span>
                  <a
                    href={`/api/orders/${found.order.number}/emails/${encodeURIComponent(email.id)}?key=${encodeURIComponent(key)}`}
                    target="_blank"
                    rel="noopener"
                    class="inline-flex min-h-11 items-center font-semibold underline underline-offset-4"
                  >
                    {t(lang, 'demo.emailsOpen')}
                  </a>
                </li>
              ))}
            </ul>
          )}
        </section>
      )}
      <section class="flex flex-col gap-2 text-sm" aria-labelledby="order-history">
        <h2 id="order-history" class="text-lg font-semibold">
          {t(lang, 'order.history')}
        </h2>
        <ol class="flex flex-col gap-2">
          {found.events.map((event) => (
            <li class="border-text/10 border-l-2 pl-3">{orderEventLabel(lang, event.type)}</li>
          ))}
        </ol>
      </section>
    </article>
  ) : (
    <p class="text-lg">{t(lang, 'order.notFound')}</p>
  )}
</StoreLayout>
