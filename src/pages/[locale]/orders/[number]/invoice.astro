---
// Customer invoice page: the HTML document the invoice PDF is rendered from. The order access key must match, otherwise the
// answer is 404. The URL locale is only checked: the document keeps the invoice's own language, as the PDF does.
// The document has its own styles, so the store layout is not used.
import { isLocale } from '@/domain/shared/locale';

// Invoices are personal, so the page is never cached.
const { locale, number: rawNumber } = Astro.params;
const number = Number(rawNumber);
const key = Astro.url.searchParams.get('key') ?? '';
const html =
  isLocale(locale ?? '') && Number.isInteger(number) && number > 0
    ? await Astro.locals.app.invoiceHtml.execute(number, key)
    : null;
if (!html) return new Response('Not found', { status: 404, headers: { 'cache-control': 'no-store' } });
return new Response(html, {
  headers: {
    'content-type': 'text/html; charset=utf-8',
    'cache-control': 'no-store',
    // The key is in the URL, so a shared link must not be indexed.
    'x-robots-tag': 'noindex, nofollow',
  },
});
---
