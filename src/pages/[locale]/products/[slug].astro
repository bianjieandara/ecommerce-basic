---
// Product page: gallery, price for the chosen option, option links (no JavaScript needed), description and WhatsApp.
// The chosen option is the ?v= parameter; the first available option is used when it is missing.
import Icon from '@/ui/components/Icon.astro';
import Price from '@/ui/components/Price.astro';
import AddToCart from '@/ui/store/AddToCart.tsx';
import BackInStockForm from '@/ui/store/BackInStockForm.tsx';
import RelatedProducts from '@/ui/store/RelatedProducts.astro';
import TurnstileScript from '@/ui/components/TurnstileScript.astro';
import StoreLayout from '@/ui/layouts/StoreLayout.astro';
import { isLocale } from '@/domain/shared/locale';
import { PATHS, withQuery } from '@/domain/shared/paths';
import { t } from '@/ui/i18n';
import { renderMarkdown } from '@/ui/lib/markdown';
import { mediaUrl } from '@/ui/lib/media-url';
import { whatsappLink } from '@/ui/lib/whatsapp';
import { loadStoreContext } from '@/http/store-context';
import { buildTitle, catalogOptionsFor, contactFor, metaDescription, storeViewFor } from '@/http/storefront';
import { productStructuredData } from '@/ui/lib/storefront-seo';
import { themeToCss } from '@/ui/lib/theme-css';

const { locale, slug } = Astro.params;
if (!isLocale(locale ?? '') || !slug) return Astro.rewrite('/404');
const lang = locale as 'es' | 'en';

const app = Astro.locals.app;
const store = await loadStoreContext(app);
const catalog = app.catalog(store.catalog);
const product = await catalog.getProductBySlug(lang, slug);
if (!product) return Astro.rewrite('/404');
const related = await catalog.listRelatedProducts(lang, product.id, 8);

const view = storeViewFor(store, lang);
const contact = contactFor(store, lang);
const requested = Astro.url.searchParams.get('v');
const selected =
  product.variants.find((variant) => variant.id === requested) ??
  product.variants.find((variant) => variant.isActive && (!variant.trackInventory || variant.stock > 0)) ??
  product.variants[0] ??
  null;

const price = selected?.priceMinor ?? product.basePriceMinor;
const compareAt = selected?.compareAtPriceMinor ?? product.compareAtPriceMinor;
const inStock = selected !== null && selected.isActive && (!selected.trackInventory || selected.stock > 0);
// How the stock is worded follows Settings > Catalog: never a number, a number only when few are left, or always.
const { showStockOnProduct, lowStockDisplayThreshold } = store.catalog;
const countable = selected !== null && selected.trackInventory && selected.stock > 0;
const fewLeft = countable && selected.stock <= lowStockDisplayThreshold;
const stockLabel = !inStock
  ? t(lang, 'product.outOfStock')
  : countable && showStockOnProduct !== 'never' && fewLeft
    ? t(lang, 'product.onlyLeft', { count: selected.stock })
    : countable && showStockOnProduct === 'always'
      ? t(lang, 'product.unitsInStock', { count: selected.stock })
      : t(lang, 'product.inStock');
// Only tracked, active options with no stock take alerts: the same rule the subscription use case enforces.
const outOfStock = selected !== null && selected.isActive && selected.trackInventory && selected.stock <= 0;
// The settings are read only for an option that can take the form, so every other product view stays as cheap as before.
const backInStock = outOfStock && (await app.settings.get('inventory')).backInStockEnabled;
const hasOptions = product.variants.some((variant) => variant.variantLabel !== '');
const option = selected && selected.variantLabel ? ` (${selected.variantLabel})` : '';
const whatsappHref = whatsappLink(
  contact.whatsappNumber,
  t(lang, 'product.whatsappMessage', { name: product.name, option }),
);
const taxLabel = view.pricesIncludeTax ? t(lang, 'product.taxIncluded') : t(lang, 'product.taxExtra');
const alternates = Object.fromEntries(
  (Object.entries(product.alternateSlugs) as [keyof typeof product.alternateSlugs, string][]).map(
    ([code, altSlug]) => [code, PATHS.product(code, altSlug)],
  ),
);
const description = renderMarkdown(product.descriptionMd);
const pageDescription = metaDescription(
  store,
  lang,
  product.seoDescription,
  product.shortDescription,
  product.descriptionMd
    .replace(/[#*_`>[]()-]+/g, ' ')
    .replace(/s+/g, ' ')
    .slice(0, 155),
);
const mainImage = product.images[0];
const category = product.categories[0];
---

<StoreLayout
  title={buildTitle(store, lang, product.seoTitle || product.name)}
  description={pageDescription}
  locale={lang}
  storeName={store.general.storeName}
  currency={view.currency}
  country={view.country}
  alternates={alternates}
  canonical={new URL(PATHS.product(lang, slug), Astro.url.origin).toString()}
  defaultLocale={store.general.defaultLocale}
  ogImage={mainImage ? mediaUrl(mainImage.key) : undefined}
  jsonLd={productStructuredData(
    {
      origin: Astro.url.origin,
      locale: lang,
      storeName: store.general.storeName,
      labels: { home: t(lang, 'nav.home'), shop: t(lang, 'nav.shop') },
    },
    product,
    { currency: store.general.currency, exponent: catalogOptionsFor(store).exponent },
    pageDescription,
  )}
  themeCss={themeToCss(store.theme)}
  fontPreset={store.theme.fontPreset}
  webAnalyticsToken={store.integrations.webAnalyticsToken}
  contact={contact}
>
  <article class="grid gap-10 md:grid-cols-[1.15fr_1fr] md:gap-16">
    <div class="flex flex-col gap-3">
      {mainImage ? (
        <img
          src={mediaUrl(mainImage.key)}
          alt={mainImage.alt || product.name}
          width="960"
          height="960"
          fetchpriority="high"
          class="aspect-square w-full rounded-card bg-surface object-cover"
        />
      ) : (
        <div
          class="flex aspect-square w-full items-center justify-center rounded-card bg-surface font-display text-[10rem] font-semibold text-text/10"
          role="img"
          aria-label={t(lang, 'product_page.noImage')}
        >
          {product.name.charAt(0)}
        </div>
      )}
      {product.images.length > 1 && (
        <ul class="grid grid-cols-4 gap-2" aria-label={t(lang, 'product_page.gallery')}>
          {product.images.slice(1).map((image) => (
            <li>
              <img
                src={mediaUrl(image.key)}
                alt={image.alt || product.name}
                width="240"
                height="240"
                loading="lazy"
                class="aspect-square w-full rounded-2xl object-cover"
              />
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="flex flex-col gap-6 md:sticky md:top-28 md:self-start">
      <nav aria-label={t(lang, 'nav.breadcrumb')} class="text-sm text-text/70">
        <a
          href={PATHS.shop(lang)}
          class="-my-3.5 inline-flex min-h-11 min-w-11 items-center justify-center underline"
        >
          {t(lang, 'nav.shop')}
        </a>
        {category && (
          <>
            {' / '}
            <a
              href={PATHS.category(lang, category.slug)}
              class="-my-3.5 inline-flex min-h-11 min-w-11 items-center justify-center underline"
            >
              {category.name}
            </a>
          </>
        )}
      </nav>

      <header class="flex flex-col gap-2">
        <h1 class="text-2xl md:text-3xl">{product.name}</h1>
        <p class="text-lg text-text/70">{product.shortDescription}</p>
      </header>

      <div class="flex flex-wrap items-baseline gap-3">
        <Price
          amountMinor={price}
          compareAtMinor={compareAt}
          currency={view.currency}
          locale={lang}
          country={view.country}
          class="text-2xl"
        />
        <span class="text-sm text-text/60">{taxLabel}</span>
      </div>

      <p
        class={`flex items-center gap-2 text-sm font-medium ${inStock ? 'text-emerald-800' : 'text-accent'}`}
      >
        <span
          class={`size-2 rounded-full ${inStock ? 'bg-emerald-600' : 'bg-accent'}`}
          aria-hidden="true"
        ></span>
        {stockLabel}
      </p>

      {hasOptions && (
        <section aria-label={t(lang, 'product_page.variants')} class="flex flex-col gap-2">
          <h2 class="eyebrow">{t(lang, 'product_page.variants')}</h2>
          <ul class="flex flex-wrap gap-2">
            {product.variants.map((variant) => {
              const available = variant.isActive && (!variant.trackInventory || variant.stock > 0);
              return (
                <li>
                  <a
                    href={withQuery(PATHS.product(lang, slug), { v: variant.id })}
                    aria-current={selected?.id === variant.id ? 'true' : undefined}
                    class:list={[
                      'flex min-h-11 items-center rounded-full border px-5 text-sm transition-colors hover:border-text',
                      selected?.id === variant.id
                        ? 'border-text bg-text font-medium text-background'
                        : 'border-text/20',
                      available ? '' : 'opacity-70 line-through',
                    ]}
                  >
                    {variant.variantLabel}
                    {!available && <span class="sr-only">{t(lang, 'product_page.soldOut')}</span>}
                  </a>
                </li>
              );
            })}
          </ul>
        </section>
      )}

      {whatsappHref && (
        <a
          href={whatsappHref}
          target="_blank"
          rel="noopener"
          class="inline-flex min-h-12 items-center justify-center gap-2 rounded-brand border border-text/20 px-6 font-medium transition hover:border-text hover:bg-surface"
        >
          <Icon name="chat" size={18} />
          {t(lang, 'product.askWhatsApp')}
        </a>
      )}

      {selected && (
        <AddToCart
          client:idle
          productId={product.id}
          productName={product.name}
          productPath={PATHS.product(lang, slug)}
          variantId={selected.id}
          variantLabel={selected.variantLabel}
          priceMinor={price}
          compareAtPriceMinor={compareAt}
          stock={selected.stock}
          trackInventory={selected.trackInventory}
          labels={{
            add: t(lang, 'common.addToCart'),
            added: t(lang, 'cart.added'),
            quantity: t(lang, 'product.quantity'),
            soldOut: t(lang, 'product.outOfStock'),
          }}
        />
      )}
      {selected && backInStock && (
        <BackInStockForm
          client:visible
          variantId={selected.id}
          locale={lang}
          siteKey={app.config.turnstileSiteKey}
          labels={{
            title: t(lang, 'product_page.backInStockTitle'),
            intro: t(lang, 'product_page.backInStockIntro'),
            email: t(lang, 'product_page.backInStockEmail'),
            phone: t(lang, 'product_page.backInStockPhone'),
            whatsapp: t(lang, 'product_page.backInStockWhatsapp'),
            submit: t(lang, 'product_page.backInStockSubmit'),
            sending: t(lang, 'product_page.backInStockSending'),
            done: t(lang, 'product_page.backInStockDone'),
            error: t(lang, 'product_page.backInStockError'),
            invalid: t(lang, 'product_page.backInStockInvalid'),
            botFailed: t(lang, 'product_page.backInStockBotFailed'),
            rateLimited: t(lang, 'product_page.backInStockRateLimited'),
            unavailable: t(lang, 'product_page.backInStockUnavailable'),
          }}
        />
      )}
      <section class="flex flex-col gap-3 border-t border-text/10 pt-6">
        <h2 class="eyebrow">{t(lang, 'product.description')}</h2>
        <div class="max-w-prose leading-relaxed [&_p]:my-3" set:html={description} />
      </section>
    </div>
  </article>
  <RelatedProducts products={related} view={view} />
</StoreLayout>
{backInStock && <TurnstileScript />}
