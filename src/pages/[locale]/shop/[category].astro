---
// Category page: the catalog filtered to one category. Same URL rules as the shop index.
import StoreLayout from '@/ui/layouts/StoreLayout.astro';
import CatalogView from '@/ui/store/CatalogView.astro';
import { isLocale } from '@/domain/shared/locale';
import { languageSwitchSearch, loadCatalogPage } from '@/http/catalog-request';
import { loadStoreContext } from '@/http/store-context';
import { buildTitle, contactFor, metaDescription, storeViewFor } from '@/http/storefront';
import { routes } from '@/ui/lib/routes';
import { categoryStructuredData } from '@/ui/lib/storefront-seo';
import { t } from '@/ui/i18n';
import { themeToCss } from '@/ui/lib/theme-css';

const { locale, category: categorySlug } = Astro.params;
if (!isLocale(locale ?? '') || !categorySlug) return Astro.rewrite('/404');
const lang = locale as 'es' | 'en';

const app = Astro.locals.app;
const store = await loadStoreContext(app);
// The category lookup and the listing do not depend on each other, so they run together. An unknown category wastes the
// listing read, which is the rare case.
const [category, load] = await Promise.all([
  app.catalog(store.catalog).getCategoryBySlug(lang, categorySlug),
  loadCatalogPage(app, Astro.url, lang, categorySlug),
]);
if (!category) return Astro.rewrite('/404');
if ('redirectTo' in load) return Astro.redirect(load.redirectTo, 301);

const view = storeViewFor(load.store, lang);
const contact = contactFor(load.store, lang);
// The language switch goes to the same category in the other language, whose slug differs.
const slugs = await app.catalog(load.store.catalog).getCategoryAlternates(category.id);
const alternates = Object.fromEntries(
  Object.entries(slugs).map(([code, slug]) => [code, routes.category(code as 'es' | 'en', slug)]),
);
---

<StoreLayout
  title={buildTitle(load.store, lang, category.name)}
  description={metaDescription(load.store, lang, category.description)}
  locale={lang}
  storeName={load.store.general.storeName}
  currency={view.currency}
  country={view.country}
  alternates={alternates}
  switchSearch={languageSwitchSearch(load)}
  canonical={new URL(load.basePath, Astro.url.origin).toString()}
  noindex={!load.indexable}
  defaultLocale={load.store.general.defaultLocale}
  jsonLd={categoryStructuredData(
    {
      origin: Astro.url.origin,
      locale: lang,
      storeName: load.store.general.storeName,
      labels: { home: t(lang, 'nav.home'), shop: t(lang, 'nav.shop') },
    },
    category,
  )}
  themeCss={themeToCss(load.store.theme)}
  fontPreset={load.store.theme.fontPreset}
  webAnalyticsToken={load.store.integrations.webAnalyticsToken}
  contact={contact}
>
  <CatalogView
    title={category.name}
    basePath={load.basePath}
    query={load.query}
    options={load.options}
    listing={load.listing}
    facets={load.facets}
    categories={load.categories}
    view={view}
    showCategoryLinks={false}
  />
</StoreLayout>
