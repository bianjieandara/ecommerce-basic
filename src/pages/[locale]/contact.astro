---
// Contact page: the editable intro, the ways to reach the store as cards (WhatsApp first), the social links, the map (loaded
// only on request) and the Google reviews from the cache. There is no form: visitors write on WhatsApp or by email. The page
// never calls Google.
import StoreLayout from '@/ui/layouts/StoreLayout.astro';
import SectionRenderer from '@/ui/widgets/SectionRenderer.astro';
import MapFacade from '@/ui/components/MapFacade.astro';
import ContactCard from '@/ui/store/ContactCard.astro';
import type { ComponentProps } from 'astro/types';
import { isLocale } from '@/domain/shared/locale';
import { pickText } from '@/domain/shared/localized-text';
import { PATHS } from '@/domain/shared/paths';
import { t } from '@/ui/i18n';
import { whatsappLink } from '@/ui/lib/whatsapp';
import { themeToCss } from '@/ui/lib/theme-css';
import { loadStoreContext } from '@/http/store-context';
import { loadPageContent, loadSectionData } from '@/http/page-content';
import { buildTitle, catalogOptionsFor, contactFor, metaDescription, storeViewFor } from '@/http/storefront';

const { locale } = Astro.params;
if (!isLocale(locale ?? '')) return Astro.rewrite('/404');
const lang = locale as 'es' | 'en';

const app = Astro.locals.app;
const store = await loadStoreContext(app);
const view = storeViewFor(store, lang);
const contact = contactFor(store, lang);
const page = await loadPageContent(app, 'contact', lang);
const data = page
  ? await loadSectionData(app, page.sections, lang, catalogOptionsFor(store), store.catalog.newDays)
  : { productsBySection: {}, categories: [] };
const reviews = await app.reviews.forPage(lang);
const title = t(lang, 'contact.title');
const whatsappHref = whatsappLink(
  store.contact.whatsappNumber,
  pickText(store.contact.whatsappMessage, lang, 'es'),
);
const hours = pickText(store.contact.openingHours, lang, 'es');
const cards: ComponentProps<typeof ContactCard>[] = [
  whatsappHref
    ? {
        icon: 'chat',
        label: t(lang, 'contact.whatsApp'),
        value: store.contact.whatsappNumber,
        href: whatsappHref,
        primary: true,
      }
    : null,
  store.contact.email
    ? {
        icon: 'mail',
        label: t(lang, 'contact.email'),
        value: store.contact.email,
        href: `mailto:${store.contact.email}`,
      }
    : null,
  store.contact.phone
    ? {
        icon: 'phone',
        label: t(lang, 'contact.call'),
        value: store.contact.phone,
        href: `tel:${store.contact.phone}`,
      }
    : null,
  store.contact.address
    ? { icon: 'map', label: t(lang, 'contact.address'), value: store.contact.address }
    : null,
  hours ? { icon: 'clock', label: t(lang, 'contact.hours'), value: hours } : null,
].filter((card) => card !== null);
const socialLinks = Object.entries(store.contact.social).filter(
  (entry): entry is [string, string] => typeof entry[1] === 'string' && entry[1] !== '',
);
---

<StoreLayout
  title={buildTitle(store, lang, page?.seoTitle || title)}
  description={metaDescription(store, lang, page?.seoDescription ?? '')}
  locale={lang}
  storeName={store.general.storeName}
  currency={view.currency}
  country={view.country}
  alternates={{ es: PATHS.contact('es'), en: PATHS.contact('en') }}
  canonical={new URL(PATHS.contact(lang), Astro.url.origin).toString()}
  defaultLocale={store.general.defaultLocale}
  themeCss={themeToCss(store.theme)}
  fontPreset={store.theme.fontPreset}
  webAnalyticsToken={store.integrations.webAnalyticsToken}
  contact={contact}
>
  <div class="flex flex-col gap-12 md:gap-16">
    <header class="flex max-w-3xl flex-col gap-5">
      <h1 class="text-2xl md:text-3xl">{title}</h1>
      {page && (
        <SectionRenderer
          sections={page.sections}
          data={data}
          view={view}
          whatsapp={{ number: contact.whatsappNumber, message: contact.whatsappMessage }}
        />
      )}
    </header>
    <ul class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {cards.map((card) => (
        <li class="contents">
          <ContactCard {...card} />
        </li>
      ))}
    </ul>
    {socialLinks.length > 0 && (
      <ul class="-mt-4 flex flex-wrap gap-2 md:-mt-8">
        {socialLinks.map(([name, url]) => (
          <li>
            <a
              href={url}
              rel="noopener"
              class="hover:border-text inline-flex min-h-11 items-center rounded-full border border-text/20 px-5 text-sm font-medium capitalize transition-colors"
            >
              {name}
            </a>
          </li>
        ))}
      </ul>
    )}
    <MapFacade
      src={store.contact.mapsEmbedUrl}
      title={title}
      hint={t(lang, 'contact.mapHint')}
      openLabel={t(lang, 'contact.showMap')}
    />
    {reviews && (
      <section class="flex flex-col gap-6" aria-labelledby="reviews-title">
        <div class="flex flex-col gap-1">
          <h2 id="reviews-title" class="text-2xl md:text-3xl">
            {t(lang, 'contact.reviewsTitle')}
          </h2>
          {reviews.rating !== null && (
            <p class="text-text/70 text-sm">
              {t(lang, 'contact.reviewsSummary', {
                rating: reviews.rating.toFixed(1),
                count: String(reviews.ratingCount),
              })}
            </p>
          )}
        </div>
        <ul class="grid gap-3 md:grid-cols-3">
          {reviews.reviews.map((review) => (
            <li class="rounded-card bg-surface flex flex-col gap-3 p-5">
              <p class="eyebrow">
                {review.author} · {review.rating}/5
              </p>
              <p class="leading-snug font-medium">{review.text}</p>
              <p class="text-text/60 mt-auto text-xs">{review.relativeTime}</p>
            </li>
          ))}
        </ul>
        <div class="text-text/60 flex flex-wrap items-center gap-x-6 gap-y-2 text-xs">
          <p>{t(lang, 'contact.googleAttribution')}</p>
          {reviews.mapsUri && (
            <a href={reviews.mapsUri} rel="noopener" class="text-text text-sm underline">
              {t(lang, 'contact.writeReview')}
            </a>
          )}
        </div>
      </section>
    )}
  </div>
</StoreLayout>
