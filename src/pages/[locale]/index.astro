---
// Home page: the stored (or default) "home" sections, rendered in order.
import StoreLayout from '@/ui/layouts/StoreLayout.astro';
import SectionRenderer from '@/ui/widgets/SectionRenderer.astro';
import { isLocale } from '@/domain/shared/locale';
import { PATHS } from '@/domain/shared/paths';
import { loadStoreContext } from '@/http/store-context';
import { loadPageContent, loadSectionData } from '@/http/page-content';
import { buildTitle, catalogOptionsFor, contactFor, metaDescription, storeViewFor } from '@/http/storefront';
import { homeStructuredData } from '@/ui/lib/storefront-seo';
import { t } from '@/ui/i18n';
import { themeToCss } from '@/ui/lib/theme-css';

const { locale } = Astro.params;
if (!isLocale(locale ?? '')) return Astro.rewrite('/404');

const app = Astro.locals.app;
// The settings and the stored page are independent reads, so they go out together.
const [store, page] = await Promise.all([
  loadStoreContext(app),
  loadPageContent(app, 'home', locale as 'es' | 'en'),
]);
if (!page) return Astro.rewrite('/404');

const view = storeViewFor(store, locale as 'es' | 'en');
const contact = contactFor(store, view.locale);
const data = await loadSectionData(app, page.sections, view.locale, catalogOptionsFor(store), store.catalog);
---

<StoreLayout
  title={buildTitle(store, view.locale, page.seoTitle)}
  description={metaDescription(store, view.locale, page.seoDescription)}
  locale={view.locale}
  storeName={store.general.storeName}
  currency={view.currency}
  country={view.country}
  alternates={{ es: PATHS.home('es'), en: PATHS.home('en') }}
  canonical={new URL(PATHS.home(view.locale), Astro.url.origin).toString()}
  defaultLocale={store.general.defaultLocale}
  jsonLd={homeStructuredData(
    {
      origin: Astro.url.origin,
      locale: view.locale,
      storeName: store.general.storeName,
      labels: { home: t(view.locale, 'nav.home'), shop: t(view.locale, 'nav.shop') },
    },
    { email: contact.email, address: contact.address },
  )}
  themeCss={themeToCss(store.theme)}
  fontPreset={store.theme.fontPreset}
  webAnalyticsToken={store.integrations.webAnalyticsToken}
  contact={contact}
>
  <div class="flex flex-col gap-16 md:gap-24">
    {/* The sections use h2 headings, so the page's one h1 is the store name, for screen readers and search engines. */}
    <h1 class="sr-only">{store.general.storeName}</h1>
    <SectionRenderer
      sections={page.sections}
      data={data}
      view={view}
      whatsapp={{ number: contact.whatsappNumber, message: contact.whatsappMessage }}
    />
  </div>
</StoreLayout>
