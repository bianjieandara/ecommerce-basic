---
// Admin invoice list: the invoices the filters match, with the totals of the issued ones. The filters live in the query string, so a
// filtered view can be bookmarked and paged through.
import AdminLayout from '@/ui/layouts/AdminLayout.astro';
import AdminPager from '@/ui/admin/AdminPager.astro';
import DataTable from '@/ui/admin/DataTable.astro';
import ListToolbar from '@/ui/admin/ListToolbar.astro';
import StatusBadge from '@/ui/admin/StatusBadge.astro';
import { BUTTON, FIELD, LABEL } from '@/ui/admin/lib/classes';
import { INVOICE_STATUSES, formatInvoiceNumber } from '@/domain/invoicing/invoice';
import { formatDate, formatMoney } from '@/domain/shared/format';
import { money } from '@/domain/shared/money';
import { totalPagesFor } from '@/domain/shared/pagination';
import { ADMIN_PATHS } from '@/domain/shared/paths';
import { invoiceFilterFrom } from '@/http/admin-invoice-page';
import { ADMIN_LIST_PAGE_SIZE, EXPORT_ROW_LIMIT } from '@/http/admin-lists';
import { positiveInteger } from '@/http/list-query';
import { loadStoreContext } from '@/http/store-context';
import { pickNamespace, t } from '@/ui/i18n';

const admin = Astro.locals.admin;
if (!admin) return Astro.redirect(ADMIN_PATHS.login);
const lang = admin.locale;
const app = Astro.locals.app;
const store = await loadStoreContext(app);
const { timezone, currency, country, storeName } = store.general;
const params = Astro.url.searchParams;
const labels = pickNamespace(lang, 'admin').invoices;

const filter = invoiceFilterFrom(params, timezone);
const { status, series, search } = filter;
const page = positiveInteger(params.get('page'));
const result = await app.adminOps.reads.invoices.list(filter, page, ADMIN_LIST_PAGE_SIZE);
const totalPages = totalPagesFor(result.total, ADMIN_LIST_PAGE_SIZE);
// The export carries the same filters as the screen, so the file matches what is on it.
const query = params.toString();
const exportHref = query ? `/api/admin/invoices/export?${query}` : '/api/admin/invoices/export';
const price = (amount: number, code: typeof currency) => formatMoney(money(amount, code), lang, country);
---

<AdminLayout title={labels.title} locale={lang} storeName={storeName}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold">{labels.title}</h1>
    <a href={exportHref} class={BUTTON}>
      {t(lang, 'admin.inventory.exportCsv')}
    </a>
  </div>
  {result.total > EXPORT_ROW_LIMIT && (
    <p class="text-text/70 text-sm" role="note">
      {t(lang, 'admin.inventory.exportLimit', { max: EXPORT_ROW_LIMIT })}
    </p>
  )}

  <section class="grid grid-cols-2 gap-3 md:grid-cols-3" aria-label={labels.issuedTotal}>
    <div class="rounded-card border border-text/10 bg-background flex flex-col gap-1 p-4">
      <span class="text-sm text-text/70">{labels.issuedTotal}</span>
      <span class="text-xl font-semibold">{price(result.totals.totalMinor, currency)}</span>
    </div>
    <div class="rounded-card border border-text/10 bg-background flex flex-col gap-1 p-4">
      <span class="text-sm text-text/70">{labels.tax}</span>
      <span class="text-xl font-semibold">{price(result.totals.taxMinor, currency)}</span>
    </div>
    <div class="rounded-card border border-text/10 bg-background flex flex-col gap-1 p-4">
      <span class="text-sm text-text/70">
        {t(lang, 'admin.invoices.issuedCount', { count: result.totals.issued })}
      </span>
    </div>
  </section>

  <ListToolbar
    action={ADMIN_PATHS.invoices}
    search={search ?? ''}
    labels={{ search: labels.search, apply: labels.filter, clear: labels.clear }}
    clearHref={ADMIN_PATHS.invoices}
  >
    <label class={`${LABEL} sm:w-48`}>
      {labels.status}
      <select name="status" class={FIELD}>
        <option value="">{labels.allStatuses}</option>
        {INVOICE_STATUSES.map((value) => (
          <option value={value} selected={value === status}>
            {labels.statuses[value]}
          </option>
        ))}
      </select>
    </label>
    <label class={`${LABEL} sm:w-40`}>
      {labels.series}
      <input name="series" value={series ?? ''} maxlength={10} class={FIELD} />
    </label>
    <label class={`${LABEL} sm:w-44`}>
      {labels.from}
      <input type="date" name="from" value={params.get('from') ?? ''} class={FIELD} />
    </label>
    <label class={`${LABEL} sm:w-44`}>
      {labels.to}
      <input type="date" name="to" value={params.get('to') ?? ''} class={FIELD} />
    </label>
  </ListToolbar>

  {result.items.length === 0 ? (
    <p class="text-text/70 text-sm">{labels.empty}</p>
  ) : (
    <DataTable>
      <thead>
        <tr>
          <th>{labels.number}</th>
          <th>{labels.order}</th>
          <th>{labels.buyer}</th>
          <th>{labels.issued}</th>
          <th>{labels.total}</th>
          <th>{labels.status}</th>
        </tr>
      </thead>
      <tbody>
        {result.items.map((invoice) => (
          <tr>
            <td data-label={labels.number}>
              <a
                href={`${ADMIN_PATHS.invoices}/${invoice.id}`}
                class="inline-flex min-h-11 items-center font-semibold underline"
              >
                {formatInvoiceNumber(invoice.series, invoice.number)}
              </a>
            </td>
            <td data-label={labels.order}>
              <a
                href={`${ADMIN_PATHS.orders}/${invoice.orderNumber}`}
                class="inline-flex min-h-11 min-w-11 items-center underline"
              >
                {invoice.orderNumber}
              </a>
            </td>
            <td data-label={labels.buyer}>{invoice.buyerName}</td>
            <td data-label={labels.issued}>{formatDate(invoice.issuedAt, lang, country, timezone)}</td>
            <td data-label={labels.total}>{price(invoice.totalMinor, invoice.currency)}</td>
            <td data-label={labels.status}>
              <StatusBadge
                label={labels.statuses[invoice.status]}
                tone={invoice.status === 'void' ? 'muted' : 'ok'}
              />
            </td>
          </tr>
        ))}
      </tbody>
    </DataTable>
  )}

  <AdminPager locale={lang} path={ADMIN_PATHS.invoices} params={params} page={page} totalPages={totalPages} />
</AdminLayout>
