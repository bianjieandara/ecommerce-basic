---
// Admin home in two columns. Left: the last 14 days of revenue, the newest orders and the top products. Right (it stays in
// view while the left scrolls): today's figures, the work waiting for the owner and the other periods.
// One dashboard snapshot is read per request; each alert links to the list behind its number.
import AdminLayout from '@/ui/layouts/AdminLayout.astro';
import AdminCard from '@/ui/admin/AdminCard.astro';
import AdminStatList from '@/ui/admin/AdminStatList.astro';
import StatusBadge from '@/ui/admin/StatusBadge.astro';
import { ORDER_STATUS_TONE } from '@/ui/admin/orders/OrderStatusForm.tsx';
import LineChart from '@/ui/components/charts/LineChart.astro';
import { formatDateTime, formatMoney, formatNumber } from '@/domain/shared/format';
import { money } from '@/domain/shared/money';
import { ADMIN_PATHS } from '@/domain/shared/paths';
import { loadStoreContext } from '@/http/store-context';
import { t } from '@/ui/i18n';

const admin = Astro.locals.admin;
if (!admin) return Astro.redirect(ADMIN_PATHS.login);
const lang = admin.locale;
const app = Astro.locals.app;
const store = await loadStoreContext(app);
const { currency, country, storeName, timezone } = store.general;
const snapshot = await app.adminOps.dashboard.execute();

/** Counts in the store's number format. */
const count = (value: number) => formatNumber(value, lang, country);
/** Amounts are integer minor units; money() refuses anything else, so a bad total fails loudly instead of showing a wrong price. */
const price = (amountMinor: number) => formatMoney(money(amountMinor, currency), lang, country);

/** The five figures of one period, as label and formatted value pairs. */
const kpiRows = (kpis: typeof snapshot.today) => [
  { label: t(lang, 'admin.dashboard.placed'), value: count(kpis.placed) },
  { label: t(lang, 'admin.dashboard.paid'), value: count(kpis.paidOrders) },
  { label: t(lang, 'admin.dashboard.revenue'), value: price(kpis.revenueMinor) },
  { label: t(lang, 'admin.dashboard.tax'), value: price(kpis.taxMinor) },
  { label: t(lang, 'admin.dashboard.average'), value: price(kpis.averageOrderMinor) },
];

const today = { title: t(lang, 'admin.dashboard.today'), rows: kpiRows(snapshot.today) };
/** The two longer periods, reduced to what is worth comparing at a glance: sales and paid orders. */
const otherPeriods = [
  { title: t(lang, 'admin.dashboard.last7'), kpis: snapshot.last7Days },
  { title: t(lang, 'admin.dashboard.last30'), kpis: snapshot.last30Days },
].flatMap(({ title, kpis }) => [
  { label: `${title} · ${t(lang, 'admin.dashboard.revenue')}`, value: price(kpis.revenueMinor) },
  { label: `${title} · ${t(lang, 'admin.dashboard.paid')}`, value: count(kpis.paidOrders) },
]);

const seeAll = t(lang, 'admin.dashboard.seeAll');
/** Cards for the work waiting on the owner. Each one links to the list that explains its number. */
const alerts = [
  {
    label: t(lang, 'admin.dashboard.toProcess'),
    value: snapshot.ordersToProcess,
    href: `${ADMIN_PATHS.orders}?status=paid`,
    action: t(lang, 'admin.dashboard.openOrders'),
  },
  {
    label: t(lang, 'admin.dashboard.outOfStock'),
    value: snapshot.outOfStock,
    href: `${ADMIN_PATHS.inventory}?status=out`,
    action: seeAll,
  },
  {
    label: t(lang, 'admin.dashboard.lowStock'),
    value: snapshot.lowStock,
    href: `${ADMIN_PATHS.inventory}?status=low`,
    action: seeAll,
  },
  {
    label: t(lang, 'admin.dashboard.failedMessages'),
    value: snapshot.failedNotifications,
    href: ADMIN_PATHS.notificationLog,
    action: seeAll,
  },
  {
    label: t(lang, 'admin.dashboard.failedJobs'),
    value: snapshot.unresolvedJobs,
    href: ADMIN_PATHS.jobs,
    action: seeAll,
  },
];
const alertRows = alerts.map((alert) => ({
  label: alert.label,
  value: count(alert.value),
  href: alert.href,
  tone: alert.value > 0 ? ('alert' as const) : undefined,
}));
// The setup checklist: shown until every item is done. Each row links to the screen where the owner fixes it.
const readinessLinks = {
  storeName: `${ADMIN_PATHS.settings}/general`,
  logo: `${ADMIN_PATHS.settings}/general`,
  product: `${ADMIN_PATHS.products}/new`,
  shipping: ADMIN_PATHS.shipping,
  payment: `${ADMIN_PATHS.settings}/checkout`,
  legalPages: ADMIN_PATHS.pages,
} as const;
const readinessLabels = {
  storeName: t(lang, 'admin.dashboard.readinessStoreName'),
  logo: t(lang, 'admin.dashboard.readinessLogo'),
  product: t(lang, 'admin.dashboard.readinessProduct'),
  shipping: t(lang, 'admin.dashboard.readinessShipping'),
  payment: t(lang, 'admin.dashboard.readinessPayment'),
  legalPages: t(lang, 'admin.dashboard.readinessLegalPages'),
} as const;
const readinessRows = snapshot.readiness.map((status) => ({
  label: readinessLabels[status.item],
  value: t(lang, status.done ? 'admin.dashboard.readinessDone' : 'admin.dashboard.readinessTodo'),
  href: status.done ? undefined : readinessLinks[status.item],
  tone: status.done ? undefined : ('alert' as const),
}));
const showReadiness = snapshot.readiness.some((status) => !status.done);
const chartTitle = t(lang, 'admin.dashboard.chart');
const chartPoints = snapshot.chart.map((day) => ({ label: day.day, value: day.revenueMinor }));
---

<AdminLayout title={t(lang, 'admin.dashboard.title')} locale={lang} storeName={storeName}>
  <header class="flex flex-col gap-1">
    <h1 class="text-2xl md:text-3xl">{t(lang, 'admin.dashboard.title')}</h1>
    <p class="text-sm text-text/70">{t(lang, 'admin.dashboard.signedInAs', { name: admin.name })}</p>
  </header>

  <div class="grid items-start gap-6 lg:grid-cols-[minmax(0,1fr)_20rem]">
    <div class="flex min-w-0 flex-col gap-6">
      {showReadiness && (
        <AdminCard title={t(lang, 'admin.dashboard.readinessTitle')}>
          <p class="px-5 pt-3 text-sm text-text/70">{t(lang, 'admin.dashboard.readinessIntro')}</p>
          <AdminStatList rows={readinessRows} />
        </AdminCard>
      )}
      <AdminCard title={chartTitle}>
        <LineChart title={chartTitle} points={chartPoints} format={price} width={760} />
      </AdminCard>

      <AdminCard
        title={t(lang, 'admin.dashboard.recentOrders')}
        action={{ href: ADMIN_PATHS.orders, label: t(lang, 'admin.dashboard.allOrders') }}
        bleed
      >
        {snapshot.recentOrders.length === 0 ? (
          <p class="px-5 py-3 text-sm text-text/70">{t(lang, 'admin.dashboard.noRecentOrders')}</p>
        ) : (
          <table class="admin-table w-full text-sm">
            <thead>
              <tr>
                <th scope="col">{t(lang, 'admin.dashboard.orderNumber')}</th>
                <th scope="col">{t(lang, 'admin.dashboard.customer')}</th>
                <th scope="col">{t(lang, 'admin.dashboard.date')}</th>
                <th scope="col" class="text-right!">
                  {t(lang, 'admin.dashboard.total')}
                </th>
                <th scope="col">{t(lang, 'admin.dashboard.state')}</th>
              </tr>
            </thead>
            <tbody>
              {snapshot.recentOrders.map((order) => (
                <tr>
                  <td data-label={t(lang, 'admin.dashboard.orderNumber')}>
                    <a
                      href={`${ADMIN_PATHS.orders}/${order.number}`}
                      class="font-semibold underline underline-offset-4"
                    >
                      #{order.number}
                    </a>
                  </td>
                  <td data-label={t(lang, 'admin.dashboard.customer')}>{order.customerName}</td>
                  <td data-label={t(lang, 'admin.dashboard.date')} class="whitespace-nowrap text-text/70">
                    {formatDateTime(order.createdAt, lang, country, timezone)}
                  </td>
                  <td data-label={t(lang, 'admin.dashboard.total')} class="text-right! tabular-nums">
                    {price(order.totalMinor)}
                  </td>
                  <td data-label={t(lang, 'admin.dashboard.state')}>
                    <StatusBadge
                      label={t(lang, `admin.orders.states.${order.status}`)}
                      tone={ORDER_STATUS_TONE[order.status]}
                    />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        )}
      </AdminCard>

      <AdminCard title={t(lang, 'admin.dashboard.topProducts')}>
        {snapshot.topProducts.length === 0 ? (
          <p class="text-sm text-text/70">{t(lang, 'admin.dashboard.noTopProducts')}</p>
        ) : (
          <AdminStatList
            rows={snapshot.topProducts.map((product) => ({
              label: product.name,
              value: `${t(lang, 'admin.dashboard.units', { count: count(product.units) })} · ${price(product.revenueMinor)}`,
            }))}
          />
        )}
      </AdminCard>
    </div>

    <aside class="flex min-w-0 flex-col gap-6 lg:sticky lg:top-24">
      <AdminCard title={today.title}>
        <AdminStatList rows={today.rows} />
      </AdminCard>
      <AdminCard title={t(lang, 'admin.dashboard.attention')}>
        <AdminStatList rows={alertRows} />
      </AdminCard>
      <AdminCard title={t(lang, 'admin.dashboard.periods')}>
        <AdminStatList rows={otherPeriods} />
      </AdminCard>
    </aside>
  </div>
</AdminLayout>
