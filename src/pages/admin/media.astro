---
// Image library: upload photos (resized in the browser), see what is stored, and delete images nothing uses.
import AdminLayout from '@/ui/layouts/AdminLayout.astro';
import MediaLibrary from '@/ui/admin/MediaLibrary.tsx';
import { ADMIN_PATHS } from '@/domain/shared/paths';
import { mediaOptions } from '@/http/admin-catalog-page';
import { loadStoreContext } from '@/http/store-context';
import { pickNamespace, t } from '@/ui/i18n';

const admin = Astro.locals.admin;
if (!admin) return Astro.redirect(ADMIN_PATHS.login);
const lang = admin.locale;
const app = Astro.locals.app;
const store = await loadStoreContext(app);
const library = await app.mediaLibrary.list(1, 100);
---

<AdminLayout title={t(lang, 'admin.media.title')} locale={lang} storeName={store.general.storeName}>
  <h1 class="text-2xl font-semibold">{t(lang, 'admin.media.title')}</h1>
  <MediaLibrary
    client:load
    assets={mediaOptions(library.items)}
    labels={pickNamespace(lang, 'admin')}
    errors={pickNamespace(lang, 'errors')}
  />
</AdminLayout>
