---
// One report for the period and filters in the URL, with the list of reports beside it. `?compare=1` shows the indicators next
// to the period before instead of the cards. The screen and the CSV files below each table come from the same read.
import AdminLayout from '@/ui/layouts/AdminLayout.astro';
import ReportFilters from '@/ui/admin/reports/ReportFilters.astro';
import SideMenu from '@/ui/admin/SideMenu.astro';
import ViewSwitch from '@/ui/admin/ViewSwitch.astro';
import ReportBody from '@/ui/admin/reports/ReportView.astro';
import { formatDate } from '@/domain/shared/format';
import { ADMIN_PATHS } from '@/domain/shared/paths';
import { isReportKind } from '@/application/reports/build-report';
import { REPORT_KINDS } from '@/application/reports/view';
import { GRAIN_REPORTS } from '@/application/reports/report-definitions';
import { lastDays } from '@/application/reports/ranges';
import { reportRequestFrom } from '@/application/reports/request';
import { loadStoreContext } from '@/http/store-context';
import { t } from '@/ui/i18n';

const admin = Astro.locals.admin;
if (!admin) return Astro.redirect(ADMIN_PATHS.login);
const lang = admin.locale;
const app = Astro.locals.app;
const requested = Astro.params.report ?? '';
if (!isReportKind(requested)) return Astro.redirect(`${ADMIN_PATHS.reports}/sales`);
const kind = requested;
const store = await loadStoreContext(app);
const result = await app.reports.execute(kind, reportRequestFrom(Astro.url.searchParams), lang);
const hasGrain = GRAIN_REPORTS.includes(kind);
const format = { lang, country: result.country, currency: result.currency, timeZone: result.timeZone };
const query = new URLSearchParams({
  from: result.range.from,
  to: result.range.to,
  ...(hasGrain ? { grain: result.grain } : {}),
}).toString();
const shortcuts = {
  last7: lastDays(result.today, 7),
  last30: lastDays(result.today, 30),
  last90: lastDays(result.today, 90),
};
const title = t(lang, `admin.reports.kinds.${kind}`);
const compare = Astro.url.searchParams.get('compare') === '1';
/** The same report and period, summary or compared. */
const viewHref = (withCompare: boolean) => {
  const next = new URLSearchParams(Astro.url.searchParams);
  if (withCompare) next.set('compare', '1');
  else next.delete('compare');
  const text = next.toString();
  return `${ADMIN_PATHS.reports}/${kind}${text ? `?${text}` : ''}`;
};
const period = `${formatDate(`${result.range.from}T12:00:00Z`, lang, result.country, result.timeZone)} – ${formatDate(`${result.range.to}T12:00:00Z`, lang, result.country, result.timeZone)}`;
---

<AdminLayout
  title={`${title} · ${t(lang, 'admin.reports.title')}`}
  locale={lang}
  storeName={store.general.storeName}
>
  <h1 class="text-2xl md:text-3xl">{t(lang, 'admin.reports.title')}</h1>
  <div class="grid items-start gap-6 lg:grid-cols-[13rem_minmax(0,1fr)]">
    <div class="min-w-0 lg:sticky lg:top-24">
      <SideMenu
        label={t(lang, 'admin.reports.title')}
        items={REPORT_KINDS.map((item) => ({
          href: `${ADMIN_PATHS.reports}/${item}`,
          label: t(lang, `admin.reports.kinds.${item}`),
          current: item === kind,
        }))}
      />
    </div>
    <div class="flex min-w-0 flex-col gap-6">
      <ReportFilters
        lang={lang}
        action={`${ADMIN_PATHS.reports}/${kind}`}
        from={result.range.from}
        to={result.range.to}
        grain={hasGrain ? result.grain : null}
        shortcuts={shortcuts}
      />
      <div class="flex flex-wrap items-end justify-between gap-3">
        <div class="flex flex-col gap-1">
          <h2 class="text-xl md:text-2xl">{title}</h2>
          <p class="text-sm text-text/70">{period}</p>
        </div>
        <ViewSwitch
          label={t(lang, 'admin.reports.viewLabel')}
          current={compare ? 'compare' : 'summary'}
          options={[
            { value: 'summary', label: t(lang, 'admin.reports.viewSummary'), href: viewHref(false) },
            { value: 'compare', label: t(lang, 'admin.reports.viewCompare'), href: viewHref(true) },
          ]}
        />
      </div>
      <ReportBody
        view={result.view}
        format={format}
        csvPath={`/api/admin/reports/${kind}.csv`}
        query={query}
        compare={compare}
      />
    </div>
  </div>
</AdminLayout>
