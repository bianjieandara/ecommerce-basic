---
// Admin order detail: the order as a document with its actions beside it (OrderDocument). The page only reads; each change goes
// through an endpoint.
import AdminLayout from '@/ui/layouts/AdminLayout.astro';
import OrderDocument from '@/ui/admin/orders/OrderDocument.astro';
import { LINK_BUTTON } from '@/ui/admin/lib/classes';
import { ADMIN_PATHS } from '@/domain/shared/paths';
import { can } from '@/domain/identity/role';
import { loadAdminOrderView } from '@/http/admin-order-view';
import { pickNamespace, t } from '@/ui/i18n';

const admin = Astro.locals.admin;
if (!admin) return Astro.redirect(ADMIN_PATHS.login);
const lang = admin.locale;
const app = Astro.locals.app;
const general = await app.settings.get('general');
// Only a positive whole number names an order; anything else is the not-found page.
const text = Astro.params.number ?? '';
const view = await loadAdminOrderView(app, /^\d+$/.test(text) ? Number(text) : 0);
// The not-found text is the shared error text, so this page says the same as every other missing page.
if (!view) return new Response(t(lang, 'errors.NOT_FOUND'), { status: 404 });
const labels = pickNamespace(lang, 'admin').orders;
const title = t(lang, 'admin.orders.detailTitle', { number: view.order.number });
---

<AdminLayout title={title} locale={lang} storeName={general.storeName}>
  <a href={ADMIN_PATHS.orders} class={`${LINK_BUTTON} self-start`}>
    {labels.back}
  </a>
  <h1 class="text-2xl md:text-3xl">{title}</h1>
  <OrderDocument
    view={view}
    lang={lang}
    country={general.country}
    timezone={general.timezone}
    storeName={general.storeName}
    canRefund={can(admin.role, 'orders.refund')}
  />
</AdminLayout>
