---
// Admin order list: newest first, filtered in the URL by status, payment method, a date range and a search text. The filters are
// read once here and reused by the paging, so a filtered list pages through the same orders. "New since your last visit" lists the
// orders created after the previous visit to this list.
import AdminLayout from '@/ui/layouts/AdminLayout.astro';
import AdminPager from '@/ui/admin/AdminPager.astro';
import DataTable from '@/ui/admin/DataTable.astro';
import ListToolbar from '@/ui/admin/ListToolbar.astro';
import StatusBadge from '@/ui/admin/StatusBadge.astro';
import { BUTTON, FIELD, LABEL, LINK_BUTTON } from '@/ui/admin/lib/classes';
import { ORDER_STATUS_TONE } from '@/ui/admin/orders/OrderStatusForm.tsx';
import type { AdminOrderFilter } from '@/application/ports/order-admin';
import { PAYMENT_METHODS } from '@/application/ports/payments';
import { ORDER_STATUSES } from '@/domain/ordering/order-status';
import { formatDateTime, formatMoney } from '@/domain/shared/format';
import { money } from '@/domain/shared/money';
import { totalPagesFor } from '@/domain/shared/pagination';
import { ADMIN_PATHS } from '@/domain/shared/paths';
import { ADMIN_LIST_PAGE_SIZE } from '@/http/admin-lists';
import { positiveInteger } from '@/http/list-query';
import { dayRangeBounds, filterDay } from '@/http/store-days';
import { pickNamespace, t } from '@/ui/i18n';

/** A stored visit time when it is a valid date, otherwise null. */
const validInstant = (value: string | undefined): string | null =>
  value && !Number.isNaN(Date.parse(value)) ? new Date(value).toISOString() : null;
/** The later of the given instants, ignoring the missing ones. */
const laterOf = (...values: (string | null)[]): string | null =>
  values
    .filter((value): value is string => value !== null)
    .sort()
    .at(-1) ?? null;

const admin = Astro.locals.admin;
if (!admin) return Astro.redirect(ADMIN_PATHS.login);
const lang = admin.locale;
const app = Astro.locals.app;
const general = await app.settings.get('general');
const labels = pickNamespace(lang, 'admin').orders;
const params = Astro.url.searchParams;
const fromDay = filterDay(params.get('from'));
const toDay = filterDay(params.get('to'));
const bounds = dayRangeBounds(fromDay, toDay, general.timezone);
// Unknown values are ignored rather than refused, so an old or edited link still shows a list.
const filter: AdminOrderFilter = {
  status: ORDER_STATUSES.find((value) => value === params.get('status')) ?? null,
  paymentMethod: PAYMENT_METHODS.find((value) => value === params.get('method')) ?? null,
  // Days follow the store's clock; see dayRangeBounds.
  from: bounds.from,
  to: bounds.to,
  search: (params.get('q') ?? '').trim().slice(0, 80) || null,
};

// "New since your last visit": two cookies hold the time of the last normal visit and of the visit before it. A normal visit
// counts the orders since the last one, then moves both on. "New only" lists the orders since the visit before that one.
const isNewOnly = params.get('new') === '1';
const visitCookie = {
  path: '/admin/orders',
  maxAge: 60 * 60 * 24 * 365,
  sameSite: 'lax',
  httpOnly: true,
} as const;
const lastVisit = validInstant(Astro.cookies.get('orders_last_visit')?.value);
const previousVisit = validInstant(Astro.cookies.get('orders_previous_visit')?.value);
const now = new Date().toISOString();
if (isNewOnly) {
  filter.from = laterOf(previousVisit ?? now, bounds.from);
} else {
  Astro.cookies.set('orders_previous_visit', lastVisit ?? '', visitCookie);
  Astro.cookies.set('orders_last_visit', now, visitCookie);
}
const newSinceCount =
  !isNewOnly && lastVisit
    ? (await app.adminOps.reads.orders.list({ ...filter, from: laterOf(lastVisit, bounds.from) }, 1, 1)).total
    : 0;
const newOnlyParams = new URLSearchParams(params);
newOnlyParams.set('new', '1');
newOnlyParams.delete('page');
const newOnlyHref = `${ADMIN_PATHS.orders}?${newOnlyParams.toString()}`;

const page = positiveInteger(params.get('page'));
const result = await app.adminOps.reads.orders.list(filter, page, ADMIN_LIST_PAGE_SIZE);
const totalPages = totalPagesFor(result.total, ADMIN_LIST_PAGE_SIZE);
const pagingParams = new URLSearchParams(params);
pagingParams.delete('page');
---

<AdminLayout title={labels.title} locale={lang} storeName={general.storeName}>
  <h1 class="text-2xl font-semibold">{labels.title}</h1>

  <ListToolbar
    action={ADMIN_PATHS.orders}
    search={filter.search ?? ''}
    labels={{ search: labels.search, apply: labels.filter, clear: labels.clear }}
    clearHref={ADMIN_PATHS.orders}
  >
    <label class={`${LABEL} sm:w-48`}>
      {labels.status}
      <select name="status" class={FIELD}>
        <option value="" selected={!filter.status}>
          {labels.allStatuses}
        </option>
        {ORDER_STATUSES.map((status) => (
          <option value={status} selected={filter.status === status}>
            {labels.states[status]}
          </option>
        ))}
      </select>
    </label>
    <label class={`${LABEL} sm:w-48`}>
      {labels.method}
      <select name="method" class={FIELD}>
        <option value="" selected={!filter.paymentMethod}>
          {labels.allMethods}
        </option>
        {PAYMENT_METHODS.map((method) => (
          <option value={method} selected={filter.paymentMethod === method}>
            {labels.methods[method]}
          </option>
        ))}
      </select>
    </label>
    <label class={`${LABEL} sm:w-44`}>
      {labels.from}
      <input type="date" name="from" value={fromDay ?? ''} class={FIELD} />
    </label>
    <label class={`${LABEL} sm:w-44`}>
      {labels.to}
      <input type="date" name="to" value={toDay ?? ''} class={FIELD} />
    </label>
  </ListToolbar>

  {isNewOnly ? (
    <p class="text-sm">{t(lang, 'admin.orders.newSinceVisit', { count: result.total })}</p>
  ) : (
    lastVisit && (
      <p class="text-sm">
        <a href={newOnlyHref} class={BUTTON}>
          {t(lang, 'admin.orders.newSinceVisit', { count: newSinceCount })}
        </a>
      </p>
    )
  )}

  <DataTable>
    <thead>
      <tr>
        <th scope="col">{labels.number}</th>
        <th scope="col">{labels.date}</th>
        <th scope="col">{labels.customer}</th>
        <th scope="col">{labels.total}</th>
        <th scope="col">{labels.payment}</th>
        <th scope="col">{labels.status}</th>
      </tr>
    </thead>
    <tbody>
      {result.items.map((row) => (
        <tr>
          <td data-label={labels.number}>
            <a href={`${ADMIN_PATHS.orders}/${row.number}`} class={LINK_BUTTON}>
              {row.number}
            </a>
          </td>
          <td data-label={labels.date}>
            {formatDateTime(row.createdAt, lang, general.country, general.timezone)}
          </td>
          <td data-label={labels.customer}>
            <span class="flex min-w-0 flex-col">
              <span class="font-semibold">{row.customerName}</span>
              <span class="text-text/70 break-all">{row.customerEmail}</span>
            </span>
          </td>
          <td data-label={labels.total}>
            {formatMoney(money(row.totalMinor, row.currency), lang, general.country)}
          </td>
          <td data-label={labels.payment}>{labels.methods[row.paymentMethod] ?? row.paymentMethod}</td>
          <td data-label={labels.status}>
            <StatusBadge label={labels.states[row.status]} tone={ORDER_STATUS_TONE[row.status]} />
          </td>
        </tr>
      ))}
    </tbody>
  </DataTable>

  {result.items.length === 0 && <p class="text-text/70 text-sm">{labels.empty}</p>}

  <AdminPager
    locale={lang}
    path={ADMIN_PATHS.orders}
    params={pagingParams}
    page={page}
    totalPages={totalPages}
  />
</AdminLayout>
