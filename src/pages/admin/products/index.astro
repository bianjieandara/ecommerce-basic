---
// Admin product list, as a picture grid or as rows (the `view` parameter). Filters and the view are query parameters, so the list
// works without JavaScript and a filtered view can be shared. Both views have a selection box per product; the bulk bar
// (an island) publishes or unpublishes the selection.
import AdminLayout from '@/ui/layouts/AdminLayout.astro';
import AdminCard from '@/ui/admin/AdminCard.astro';
import ListToolbar from '@/ui/admin/ListToolbar.astro';
import ProductBulkBar from '@/ui/admin/ProductBulkBar.tsx';
import ProductListRow from '@/ui/admin/ProductListRow.astro';
import ProductTile from '@/ui/admin/ProductTile.astro';
import ViewSwitch from '@/ui/admin/ViewSwitch.astro';
import { BUTTON_PRIMARY, FIELD, LABEL, LINK_BUTTON } from '@/ui/admin/lib/classes';
import { ADMIN_PATHS } from '@/domain/shared/paths';
import { formatMoney } from '@/domain/shared/format';
import { categoryOptions, productFilterFrom } from '@/http/admin-catalog-page';
import { listHref } from '@/http/list-query';
import { loadStoreContext } from '@/http/store-context';
import { t } from '@/ui/i18n';

const admin = Astro.locals.admin;
if (!admin) return Astro.redirect(ADMIN_PATHS.login);
const lang = admin.locale;
const app = Astro.locals.app;
const store = await loadStoreContext(app);
const params = Astro.url.searchParams;
const filter = productFilterFrom(params);
const [result, categories] = await Promise.all([
  app.catalogAdmin.productList.listProducts(filter, lang),
  app.catalogAdmin.categories.list(),
]);
const choices = categoryOptions(categories, lang);
/** The grid is the default; any other value falls back to it. */
const view = params.get('view') === 'rows' ? 'rows' : 'grid';
const viewHref = (value: string) => {
  const next = new URLSearchParams(params);
  next.set('view', value);
  next.delete('page');
  return `${ADMIN_PATHS.products}?${next}`;
};
const priceOf = (amountMinor: number) =>
  formatMoney({ amountMinor, currency: store.general.currency }, lang, store.general.country);
const bulkLabels = {
  selected: t(lang, 'admin.products.selected', { count: '{count}' }),
  publish: t(lang, 'admin.products.bulkPublish'),
  unpublish: t(lang, 'admin.products.bulkUnpublish'),
  failed: t(lang, 'admin.products.bulkFailed'),
  working: t(lang, 'admin.products.bulkWorking'),
};
const statusLabel = {
  draft: t(lang, 'admin.status.draft'),
  active: t(lang, 'admin.status.active'),
  archived: t(lang, 'admin.status.archived'),
};
const rowLabels = {
  publish: t(lang, 'admin.products.publish'),
  unpublish: t(lang, 'admin.products.unpublish'),
  duplicate: t(lang, 'admin.products.duplicate'),
  working: t(lang, 'admin.products.working'),
  failed: t(lang, 'admin.products.failed'),
};
---

<AdminLayout title={t(lang, 'admin.products.title')} locale={lang} storeName={store.general.storeName}>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h1 class="text-2xl font-semibold">{t(lang, 'admin.products.title')}</h1>
    <div class="flex flex-wrap items-center gap-3">
      <ViewSwitch
        label={t(lang, 'admin.products.viewLabel')}
        current={view}
        options={[
          { value: 'grid', label: t(lang, 'admin.products.viewGrid'), href: viewHref('grid') },
          { value: 'rows', label: t(lang, 'admin.products.viewRows'), href: viewHref('rows') },
        ]}
      />
      <a href={`${ADMIN_PATHS.products}/new`} class={BUTTON_PRIMARY}>
        {t(lang, 'admin.products.new')}
      </a>
    </div>
  </div>

  <ListToolbar
    action={ADMIN_PATHS.products}
    search={filter.search}
    labels={{
      search: t(lang, 'admin.products.search'),
      apply: t(lang, 'admin.products.apply'),
      clear: t(lang, 'admin.products.clear'),
    }}
    clearHref={ADMIN_PATHS.products}
  >
    <input type="hidden" name="view" value={view} />
    <label class={`${LABEL} sm:w-44`}>
      {t(lang, 'admin.products.status')}
      <select name="status" class={FIELD}>
        <option value="all" selected={filter.status === 'all'}>
          {t(lang, 'admin.products.statusAll')}
        </option>
        <option value="draft" selected={filter.status === 'draft'}>
          {statusLabel.draft}
        </option>
        <option value="active" selected={filter.status === 'active'}>
          {statusLabel.active}
        </option>
        <option value="archived" selected={filter.status === 'archived'}>
          {statusLabel.archived}
        </option>
      </select>
    </label>
    <label class={`${LABEL} sm:w-52`}>
      {t(lang, 'admin.products.category')}
      <select name="category" class={FIELD}>
        <option value="">{t(lang, 'admin.products.categoryAll')}</option>
        {choices.map((choice) => (
          <option value={choice.id} selected={filter.categoryId === choice.id}>
            {`${'— '.repeat(choice.depth)}${choice.label}`}
          </option>
        ))}
      </select>
    </label>
    <label class="flex min-h-11 items-center gap-2 text-sm">
      <input type="checkbox" name="sale" value="1" class="size-5" checked={filter.onSale} />
      {t(lang, 'admin.products.onSale')}
    </label>
    <label class="flex min-h-11 items-center gap-2 text-sm">
      <input type="checkbox" name="stock" value="1" class="size-5" checked={filter.outOfStock} />
      {t(lang, 'admin.products.outOfStock')}
    </label>
  </ListToolbar>

  {result.items.length > 0 && view === 'grid' && (
    <ul class="grid grid-cols-2 gap-3 md:grid-cols-3 md:gap-4 xl:grid-cols-4">
      {result.items.map((product) => (
        <li class="contents">
          <ProductTile
            product={product}
            price={priceOf(product.basePriceMinor)}
            statusLabel={statusLabel[product.status]}
            stockLabel={`${t(lang, 'admin.products.columnStock')}: ${product.stock}`}
            selectLabel={t(lang, 'admin.products.selectRow', { name: product.name })}
          />
        </li>
      ))}
    </ul>
  )}
  {result.items.length > 0 && view === 'rows' && (
    <AdminCard title={t(lang, 'admin.products.title')} bleed>
      <ul class="divide-y divide-text/10">
        {result.items.map((product) => (
          <ProductListRow
            product={product}
            price={priceOf(product.basePriceMinor)}
            statusLabel={statusLabel[product.status]}
            stockLabel={`${t(lang, 'admin.products.columnStock')}: ${product.stock}`}
            variantsLabel={`${t(lang, 'admin.products.columnVariants')}: ${product.variantCount}`}
            selectLabel={t(lang, 'admin.products.selectRow', { name: product.name })}
            actionLabels={rowLabels}
          />
        ))}
      </ul>
    </AdminCard>
  )}
  <ProductBulkBar client:idle labels={bulkLabels} />

  {result.items.length === 0 && <p class="text-sm text-text/70">{t(lang, 'admin.products.empty')}</p>}

  <nav class="flex items-center justify-between gap-3 text-sm" aria-label={t(lang, 'admin.products.title')}>
    {result.page > 1 ? (
      <a href={listHref(ADMIN_PATHS.products, params, result.page - 1)} class={LINK_BUTTON}>
        {t(lang, 'admin.products.prev')}
      </a>
    ) : (
      <span />
    )}
    <span>{t(lang, 'admin.products.pageOf', { page: result.page, total: result.totalPages })}</span>
    {result.page < result.totalPages ? (
      <a href={listHref(ADMIN_PATHS.products, params, result.page + 1)} class={LINK_BUTTON}>
        {t(lang, 'admin.products.next')}
      </a>
    ) : (
      <span />
    )}
  </nav>
</AdminLayout>
