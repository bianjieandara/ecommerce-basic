---
// The settings have no page of their own: the first group opens, with the list of groups beside it.
import { settingsGroupNames } from '@/ui/admin/settings-labels';
import { ADMIN_PATHS } from '@/domain/shared/paths';

const admin = Astro.locals.admin;
if (!admin) return Astro.redirect(ADMIN_PATHS.login);
const first = Object.keys(settingsGroupNames(admin.locale))[0];
return Astro.redirect(`${ADMIN_PATHS.settings}/${first}`);
---
