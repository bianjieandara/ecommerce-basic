---
// One settings group, edited with the schema form, with the list of groups beside it. Only owners may save; the endpoint checks the same permission.
import AdminLayout from '@/ui/layouts/AdminLayout.astro';
import AdminCard from '@/ui/admin/AdminCard.astro';
import SchemaForm from '@/ui/admin/schema-form/SchemaForm.tsx';
import SideMenu from '@/ui/admin/SideMenu.astro';
import { settingsGroupNames } from '@/ui/admin/settings-labels';
import { can } from '@/domain/identity/role';
import { ADMIN_PATHS } from '@/domain/shared/paths';
import type { SettingsGroup } from '@/application/content/settings-schemas';
import { settingsFormFields } from '@/application/content/settings-fields';
import { loadStoreContext } from '@/http/store-context';
import { t } from '@/ui/i18n';

const admin = Astro.locals.admin;
if (!admin) return Astro.redirect(ADMIN_PATHS.login);
const lang = admin.locale;
const app = Astro.locals.app;
const store = await loadStoreContext(app);
const names = settingsGroupNames(lang);
const requested = Astro.params.group ?? '';
if (!Object.hasOwn(names, requested)) return new Response(t(lang, 'errors.NOT_FOUND'), { status: 404 });
const group = requested as SettingsGroup;
const canEdit = can(admin.role, 'settings.manage');
// The notice below is the page; the status says so too, so nothing downstream treats it as a normal screen.
if (!canEdit) Astro.response.status = 403;
const values = await app.settings.get(group);
const library = await app.mediaLibrary.list(1, 100);
const media = library.items.map((asset) => ({ id: asset.id, label: asset.originalName }));
const fields = settingsFormFields(group);
const labels = {
  save: t(lang, 'admin.form.save'),
  saving: t(lang, 'admin.form.saving'),
  saved: t(lang, 'admin.form.saved'),
  failed: t(lang, 'admin.form.failed'),
  none: t(lang, 'admin.form.none'),
  invalid: t(lang, 'admin.form.invalid'),
};
---

<AdminLayout title={names[group]} locale={lang} storeName={store.general.storeName}>
  <h1 class="text-2xl md:text-3xl">{t(lang, 'admin.settings.title')}</h1>
  <div class="grid items-start gap-6 lg:grid-cols-[15rem_minmax(0,1fr)]">
    <div class="min-w-0 lg:sticky lg:top-24">
      <SideMenu
        label={t(lang, 'admin.settings.title')}
        items={Object.entries(names).map(([key, label]) => ({
          href: `${ADMIN_PATHS.settings}/${key}`,
          label,
          current: key === group,
        }))}
      />
    </div>
    <AdminCard title={names[group]}>
      {canEdit ? (
        <SchemaForm
          client:load
          fields={fields}
          values={values}
          locale={lang}
          saveUrl={`/api/admin/settings/${group}`}
          media={media}
          labels={labels}
        />
      ) : (
        <p class="text-sm text-text/70">{t(lang, 'errors.FORBIDDEN')}</p>
      )}
    </AdminCard>
  </div>
</AdminLayout>
