---
// Sets a new password from the link in the email. Without a token the page only says what is wrong.
import AuthForm from '@/ui/admin/AuthForm.tsx';
import AuthLayout from '@/ui/layouts/AuthLayout.astro';
import { ADMIN_PATHS } from '@/domain/shared/paths';
import { loadStoreContext } from '@/http/store-context';
import { pickNamespace, t } from '@/ui/i18n';

const app = Astro.locals.app;
const store = await loadStoreContext(app);
const lang = store.general.defaultLocale;
const token = Astro.url.searchParams.get('token') ?? '';
const errors = { ...pickNamespace(lang, 'errors'), INVALID_STATE: t(lang, 'admin.reset.invalidLink') };
---

<AuthLayout title={t(lang, 'admin.reset.title')} locale={lang} storeName={store.general.storeName}>
  {token ? (
    <AuthForm
      client:load
      mode="reset"
      locale={lang}
      siteKey={app.config.turnstileSiteKey}
      token={token}
      labels={{
        password: t(lang, 'admin.common.newPassword'),
        submit: t(lang, 'admin.reset.submit'),
        submitting: t(lang, 'admin.common.submitting'),
        done: t(lang, 'admin.reset.done'),
        signIn: t(lang, 'admin.common.signIn'),
      }}
      errors={errors}
    />
  ) : (
    <p role="alert" class="text-sm">
      {t(lang, 'admin.reset.missingToken')}
    </p>
  )}
  <a href={ADMIN_PATHS.forgotPassword} class="inline-flex min-h-11 items-center text-sm underline">
    {t(lang, 'admin.common.requestNew')}
  </a>
</AuthLayout>
