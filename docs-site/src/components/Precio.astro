---
// Un importe suelto, en la moneda de la región del visitante. Emite una línea por región y el CSS de guide-region.css enseña la
// que toca; antes solo renderizaba Ecuador, así que México y el resto leían la sección de precios sin un solo número.
import { REGIONS } from '../data/regions.mjs';
import { cargarPrecios, CLAVE_REGION, formatearPrecio, type Lang } from '../data/precios';

interface Props {
  id: string;
  lang: Lang;
  /** Texto delante del importe. Por defecto, el de la tienda. */
  label?: string;
}
const { id, lang, label } = Astro.props;

const precios = await cargarPrecios();
const prefijo = label ?? (lang === 'en' ? 'Your online store, from' : 'Tu tienda en línea, desde');

const lineas = REGIONS.map((region) => {
  const precio = precios[id]?.[CLAVE_REGION[region]];
  return { region, precio: precio ? formatearPrecio(precio, lang) : null };
});
---

{
  lineas.map(({ region, precio }) =>
    precio ? (
      <p class="guide-price" data-region-only={region}>
        <span class="guide-price-label">{prefijo}</span>
        <b class="guide-price-amount">{precio.importe}</b>
        {precio.nota && <span class="guide-price-note">{precio.nota}</span>}
      </p>
    ) : null,
  )
}
