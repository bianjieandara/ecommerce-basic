---
// One price block of the "changes we make for you" service: a table for per-change prices and credit packs, cards for the monthly
// and yearly plans. It renders the block for every region and the CSS shows the visitor's one, so the page stays static. Numbers
// come from data/change-plans.ts, which reads the amounts from the price table e-baq.com publishes.
import PriceTable from './PriceTable.astro';
import PlanCards from './PlanCards.astro';
import { REGIONS } from '../data/regions.mjs';
import {
  CHANGE_SIZES,
  PLAN_RESPONSE_DAYS,
  cargarPreciosCambios,
  YEARLY_CHECKUPS,
  YEARLY_MONTHS,
  formatMoney,
  packSavingPercent,
  type Lang,
} from '../data/change-plans';
import { COPY } from '../data/change-plans-copy';

interface Props {
  lang: Lang;
  part: 'single' | 'packs' | 'plans' | 'yearly';
}
const { lang, part } = Astro.props;
const copy = COPY[lang];
const PRICES = await cargarPreciosCambios();

/** Rows of a plan table as cards: the name is the first cell, `price` and `sub` say which cells hold the price lines, the rest are listed. */
function cardsFor(table: { head: string[]; rows: string[][] }, price: number, sub?: number) {
  return table.rows.map((cells) => ({
    name: cells[0],
    price: cells[price],
    sub: sub === undefined ? table.head[price] : cells[sub],
    lines: cells
      .map((value, i) => ({ label: table.head[i], value, i }))
      .filter(({ i }) => i !== 0 && i !== price && i !== sub),
  }));
}

/** Head and rows of the requested table for one region. */
function tableFor(region: (typeof REGIONS)[number]) {
  const prices = PRICES[region];
  const money = (amount: number, decimals = 0) => formatMoney(amount, region, lang, decimals);
  if (part === 'single') {
    return {
      head: copy.single.head,
      rows: CHANGE_SIZES.map(({ id, credits }) => [
        copy.single.sizes[id],
        copy.single.credits(credits),
        money(prices.credit * credits),
      ]),
    };
  }
  if (part === 'packs') {
    return {
      head: copy.packs.head,
      rows: prices.packs.map((pack) => [
        copy.packs.pack(pack.credits),
        money(pack.price),
        money(pack.price / pack.credits, 2),
        copy.packs.saving(packSavingPercent(prices, pack)),
      ]),
    };
  }
  if (part === 'plans') {
    return {
      head: copy.plans.head,
      rows: prices.plans.map((plan) => [
        copy.plans.names[plan.id],
        String(plan.creditsPerMonth),
        copy.plans.response(PLAN_RESPONSE_DAYS[plan.id]),
        money(plan.monthly),
      ]),
    };
  }
  return {
    head: copy.yearly.head,
    rows: prices.plans.map((plan) => {
      const yearly = plan.monthly * YEARLY_MONTHS;
      return [
        copy.yearly.names[plan.id],
        String(plan.creditsPerMonth * 12),
        copy.plans.response(PLAN_RESPONSE_DAYS[plan.id]),
        copy.yearly.checkups(YEARLY_CHECKUPS[plan.id]),
        money(yearly),
        copy.yearly.perMonth(money(yearly / 12, 2)),
      ];
    }),
  };
}
---

{
  REGIONS.map((region) => {
    const table = tableFor(region);
    return (
      <div data-region-only={region}>
        {part === 'plans' && <PlanCards plans={cardsFor(table, 3)} />}
        {part === 'yearly' && <PlanCards plans={cardsFor(table, 4, 5)} />}
        {(part === 'single' || part === 'packs') && <PriceTable {...table} />}
      </div>
    );
  })
}
